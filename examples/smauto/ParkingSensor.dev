DEVICE ParkingSensor WITH description="Device for distance sensing", author="maria", os=raspbian;

USE RaspberryPi_5_8GB;
USE SRF05[ParkingDistance] WITH frequency = 20.0;

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] locsys_broker WITH host="locsys.issel.ee.auth.gr", port=1883, auth.username="sensors", auth.password="issel.sensors", ssl=False;

CONNECT ParkingDistance WITH
    POWER
        GND -- GND_1,
        VCC -- power_5v_a
    DATA
        gpio[mode="input"] echo -- GPIO24,
        gpio[mode="output"] trigger -- GPIO23
    @ "my_raspi.sensors.distance.srf05";