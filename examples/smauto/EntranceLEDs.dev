DEVICE EntranceLEDs WITH description="Embedded device with SRF and LEDs", author="maria", os=raspbian;

USE RaspberryPi_5_8GB;
USE SRF05[EntranceSRF], WS2812[RoomLights];

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] locsys_broker WITH host="locsys.issel.ee.auth.gr", port=1883, auth.username="sensors", auth.password="issel.sensors", ssl=False;

CONNECT EntranceSRF WITH
    POWER
        GND_1 -- GND,
        power_5v_a -- VCC
    DATA
        gpio[mode="input"] GPIO24 -- echo,
        gpio[mode="output"] GPIO23 -- trigger
;

CONNECT RoomLights WITH
    POWER
        GND_2 -- GND,
        power_5v_b -- VCC
    DATA
        gpio[mode="output"] GPIO10 -- DIN
;