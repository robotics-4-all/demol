DEVICE SmartWindow WITH description="My RaspberryPi 5 with a BME680 and a ServoMotor to open and close a window", author="maria", os=raspbian;

USE RaspberryPi_5_8GB;
USE BME680[TempSensor], PCA9685[WindowController] WITH 
        channel = 7,
        initial_angle = 0.0,
        final_angle = 0.0,
        angular_speed = 9.0,
        angular_step = 1.0
    ;

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] locsys_broker WITH host="locsys.issel.ee.auth.gr", port=1883, auth.username="sensors", auth.password="issel.sensors";

CONNECT TempSensor WITH
    POWER
        gnd -- GND_1,
        vcc -- power_5v_a
    DATA
        i2c[slave_address=0x76] sda sda -- GPIO2, scl scl -- GPIO3
;

CONNECT WindowController WITH
    POWER
        GND_1 -- GND_2,
        VCC_1 -- power_5v_b
    DATA
        i2c[slave_address=0x40] sda SDA_1 -- GPIO2, scl SCL_1 -- GPIO3
;