DEVICE RpiApds9960Gesture WITH description="RaspberryPi 5 with APDS9960 light, gesture, color, proximity sensor over I2C", author="demol", os=raspbian;

USE RaspberryPi_5_8GB;
USE APDS9960[GestureSensor];

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] MyBroker WITH host="localhost", port=1883, auth.username="guest", auth.password="guest", ssl=False;

CONNECT GestureSensor WITH
    POWER
        GND -- GND_1,
        VCC -- power_3v3_a
    DATA
        i2c[slave_address=0x39] sda sda -- GPIO2, scl scl -- GPIO3
    @ "my_raspi.sensors.light.apds9960";
