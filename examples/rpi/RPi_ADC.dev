DEVICE RpiComplete WITH description="My RaspberryPi 5 with a TCRT5000 tracker sensor", author="maria", os=raspbian;

USE RaspberryPi_5_8GB;
USE VL53L1X[MyToF], TCRT5000[MyTracker], TFMini[MyTFMini], BME680[MyBME], SRF05[MySRF], ADCDifferentialPi[MyADC] WITH 
        resolution = 18,
        gain = 1,
        channel = 8
    , WS2812[MyLedRing] WITH 
        colors = ['0xFF0000', '0x00FF00', '0x0000FF', '0xFFFF00', '0xFF00FF', '0x00FFFF', '0xFFFFFF', '0x800000', '0x008000', '0x000080', '0xFFA500', '0x800080']
    , PCA9685[MyServoController] WITH 
        channel = 2,
        initial_angle = 90.0,
        final_angle = 180.0,
        angular_speed = 10.0
    ;

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] MyBroker WITH host="localhost", port=1883, auth.username="guest", auth.password="guest", ssl=False;

CONNECT MyToF WITH
    POWER
        GND_3 -- GND,
        power_3v3_a -- VIN
    DATA
        i2c[slave_address=0x29] sda GPIO2 -- SDA, scl GPIO3 -- SCL
    @ "my_raspi.sensors.tof.vl53l1x";

CONNECT MyTracker WITH
    POWER
        GND_1 -- GND,
        power_5v_a -- VCC
    DATA
        gpio[mode="input"] GPIO4 -- D0
    @ "my_raspi.sensors.tracker.TCRT5000";

CONNECT MyTFMini WITH
    POWER
        GND_4 -- GND,
        power_5v_b -- VCC
    DATA
        uart[baudrate=115200] tx GPIO14 -- RXD, rx GPIO15 -- TXD
    @ "my_raspi.sensors.tfmini";

CONNECT MyBME WITH
    POWER
        GND_3 -- gnd,
        power_5v_a -- vcc
    DATA
        i2c[slave_address=0x76] sda GPIO2 -- sda, scl GPIO3 -- scl
    @ "my_raspi.sensors.env.bme680";

CONNECT MySRF WITH
    POWER
        GND_2 -- GND,
        power_5v_b -- VCC
    DATA
        gpio[mode="output"] GPIO23 -- trigger,
        gpio[mode="input"] GPIO24 -- echo
    @ "my_raspi.sensors.distance.srf05"; 

CONNECT MyADC WITH
    POWER
        GND_3 -- GND,
        power_5v_a -- VCC
    DATA
        i2c[slave_address=0x68] sda GPIO2 -- SDA, scl GPIO3 -- SCL
    @ "my_raspi.sensors.adc.MyADC";

CONNECT MyLedRing WITH
    POWER
        GND_4 -- GND,
        power_5v_b -- VCC
    DATA
        gpio[mode="output"] GPIO10 -- DIN
    @ "my_raspi.actuators.ws2812.MyLedRing";

CONNECT MyServoController WITH
    POWER
        GND_1 -- GND_1,
        power_5v_a -- VCC_1
    DATA
        i2c[slave_address=0x64] sda GPIO2 -- SDA_1, scl GPIO3 -- SCL_1
;