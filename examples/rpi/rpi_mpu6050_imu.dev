DEVICE RpiMpu6050Imu WITH description="RaspberryPi 5 with MPU6050 6-axis IMU (accelerometer + gyroscope) over I2C", author="demol", os=raspbian;

USE RaspberryPi_5_8GB;
USE MPU6050[Imu];

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] MyBroker WITH host="localhost", port=1883, auth.username="guest", auth.password="guest", ssl=False;

CONNECT Imu WITH
    POWER
        GND -- GND_1,
        VCC -- power_3v3_a
    DATA
        i2c[slave_address=0x68] sda sda -- GPIO2, scl scl -- GPIO3
    @ "my_raspi.sensors.imu.mpu6050";
