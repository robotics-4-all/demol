DEVICE MyPiIotDevice WITH description="My RaspberryPi IoT device", author="klpanagi", os=raspbian;

USE RaspberryPi_4B_4GB;
USE BME680[MyBME];

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] MyMqttBroker WITH host="node.mqtt.local", port=1883, auth.username="guest", auth.password="guest", ssl=False;

CONNECT MyBME WITH
    POWER
        GND_1 -- gnd,
        power_5v_a -- vcc
    DATA
        i2c[slave_address=0x76] sda GPIO2 -- sda, scl GPIO3 -- scl
    @ "my_esp.sensors.env.bme680";
