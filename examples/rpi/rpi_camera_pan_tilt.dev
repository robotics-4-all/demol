DEVICE CameraPanTilt WITH 
    description="Pan-tilt camera system with distance tracking", 
    author="Antigravity", 
    os=raspbian;

USE RaspberryPi_5_8GB;

// Peripherals
USE ServoGeneric[PanServo] WITH 
    min_angle = -90.0,
    max_angle = 90.0
;
USE ServoGeneric[TiltServo] WITH 
    min_angle = -45.0,
    max_angle = 45.0
;
USE VL53L1X[DistanceSensor];

NETWORK[WiFi] WITH 
    ssid="CameraNet", 
    password="camera_password";

BROKER[MQTT] CameraBroker WITH 
    host="localhost", 
    port=1883;

// Connections
CONNECT PanServo WITH
    POWER 
        GND_1 -- gnd, 
        power_5v_a -- vcc
    DATA 
        gpio[mode="output"] GPIO12 -- din
    @ "camera/pan";

CONNECT TiltServo WITH
    POWER 
        GND_2 -- gnd, 
        power_5v_b -- vcc
    DATA 
        gpio[mode="output"] GPIO13 -- din
    @ "camera/tilt";

CONNECT DistanceSensor WITH
    POWER 
        GND_3 -- GND, 
        power_3v3_a -- VIN
    DATA 
        i2c[slave_address=0x29] sda GPIO2 -- SDA, scl GPIO3 -- SCL
    @ "camera/distance";
