DEVICE RpiPirMotion WITH description="RaspberryPi 5 with HC-SR501 PIR motion sensor on a single GPIO digital output", author="demol", os=raspbian;

USE RaspberryPi_5_8GB;
USE PIR_HCSR501[MotionDetector];

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] MyBroker WITH host="localhost", port=1883, auth.username="guest", auth.password="guest", ssl=False;

CONNECT MotionDetector WITH
    POWER
        GND -- GND_1,
        VCC -- power_5v_a
    DATA
        gpio[mode="input"] OUT -- GPIO4
    @ "my_raspi.sensors.motion.pir";
