DEVICE RpiHw006Proximity WITH description="RaspberryPi 5 with HW-006 IR proximity switch on a single GPIO digital output", author="demol", os=raspbian;

USE RaspberryPi_5_8GB;
USE HW006[NearTrigger];

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] MyBroker WITH host="localhost", port=1883, auth.username="guest", auth.password="guest", ssl=False;

CONNECT NearTrigger WITH
    POWER
        gnd -- GND_1,
        vcc -- power_5v_a
    DATA
        gpio[mode="input"] DO -- GPIO4
    @ "my_raspi.sensors.proximity.hw006";
