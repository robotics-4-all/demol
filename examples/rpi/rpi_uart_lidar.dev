DEVICE UartLidarNode WITH 
    description="LiDAR distance sensor using UART interface", 
    author="Antigravity", 
    os=raspbian;

USE RaspberryPi_5_8GB;

// Peripherals
USE TFMini[LidarSensor];

NETWORK[WiFi] WITH 
    ssid="LidarNet", 
    password="lidar_password";

BROKER[MQTT] LidarBroker WITH 
    host="192.168.1.100", 
    port=1883,
    auth.username="lidar",
    auth.password="lidar_pass";

// Connections
CONNECT LidarSensor WITH
    POWER 
        GND_1 -- GND, 
        power_5v_a -- VCC
    DATA 
        uart[baudrate=115200] tx GPIO14 -- RXD, rx GPIO15 -- TXD
    @ "sensors/lidar";
