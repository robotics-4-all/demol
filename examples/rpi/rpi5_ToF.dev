DEVICE RpiTrackerSensor WITH description="My RaspberryPi 5 with a TCRT5000 tracker sensor", author="maria", os=raspbian;

USE RaspberryPi_5_8GB;
USE VL53L1X[MyToF], TCRT5000[MyTracker],
        TFMini[MyTFMini], BME680[MyBME], SRF05[MySRF];

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] MyBroker WITH host="localhost", port=1883, auth.username="guest", auth.password="guest", ssl=False;

CONNECT MyToF WITH
    POWER
        GND -- GND_3,
        VIN -- power_3v3_a
    DATA
        i2c[slave_address=0x29] sda SDA -- GPIO2, scl SCL -- GPIO3
    @ "my_raspi.sensors.tof.vl53l1x";

CONNECT MyTracker WITH
    POWER
        GND -- GND_1,
        VCC -- power_5v_a
    DATA
        gpio[mode="input"] D0 -- GPIO4
    @ "my_raspi.sensors.tracker.TCRT5000";

CONNECT MyTFMini WITH
    POWER
        GND -- GND_4,
        VCC -- power_5v_b
    DATA
        uart[baudrate=115200] tx RXD -- GPIO14, rx TXD -- GPIO15
    @ "my_raspi.sensors.tfmini";

CONNECT MyBME WITH
    POWER
        gnd -- GND_3,
        vcc -- power_5v_a
    DATA
        i2c[slave_address=0x76] sda sda -- GPIO2, scl scl -- GPIO3
    @ "my_raspi.sensors.env.bme680";

CONNECT MySRF WITH
    POWER
        GND -- GND_2,
        VCC -- power_5v_b
    DATA
        gpio[mode="input"] echo -- GPIO24,
        gpio[mode="output"] trigger -- GPIO23
    @ "my_raspi.sensors.distance.srf05"; 