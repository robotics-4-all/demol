DEVICE MyWemosDevice_A WITH 
    description="My WemosD1Mini IoT device",
    author="klpanagi", os=riotos;

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] MyMqttBroker WITH 
    host="node.mqtt.local",
    port=1883,
    auth.username="guest",
    auth.password="guest";

USE WemosD1Mini;
USE HCSR04P[Sonar];

CONNECT Sonar WITH
    POWER
        GND -- gnd,
        VCC -- power_3v3
    DATA
        gpio[mode="output"] trigger -- d3,
        gpio[mode="input"] echo -- d4
    @ "my_wemos.sensors.distance.sonar";