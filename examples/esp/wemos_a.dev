DEVICE MyWemosDevice_A WITH 
    description="My WemosD1Mini IoT device",
    author="klpanagi", os=riotos;

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] MyMqttBroker WITH 
    host="node.mqtt.local",
    port=1883,
    auth.username="guest",
    auth.password="guest";

USE WemosD1Mini;
USE HCSR04P[Sonar], WS281X[Ledstrip];

CONNECT Sonar WITH
    POWER
        gnd -- GND,
        power_3v3 -- VCC
    DATA
        gpio d3 -- trigger,
        gpio d4 -- echo
    @ "my_wemos.sensors.distance.sonar";

CONNECT Ledstrip WITH
    POWER
        gnd -- gnd,
        power_5v -- vcc
    DATA
        gpio d2 -- data_in
    @ "my_wemos.actuators.visual.ledstrip";
