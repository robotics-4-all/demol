DEVICE ESPDS18B20 WITH description="ESP-based DS18B20 1-Wire temperature sensor test device", author="klpanagi", os=riotos;

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] MyMqttBroker WITH host="node.mqtt.local", port=1883, auth.username="guest", auth.password="guest";

USE ESP32Wroom32;
USE DS18B20[Temp];

CONNECT Temp WITH
    POWER
        GND -- GND_1,
        VCC -- VCC_3V3
    DATA
        gpio data -- GPIO4
    @ "my_esp.sensors.temperature.ds18b20";
