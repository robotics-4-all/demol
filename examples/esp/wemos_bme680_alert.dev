DEVICE MyWemosAlert WITH description="WemosD1Mini + BME680 with ALERT triggers", author="demol";

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] MyMqttBroker WITH host="node.mqtt.local", port=1883, auth.username="guest", auth.password="guest";

USE WemosD1Mini;
USE BME680[BME];

CONNECT BME WITH
    POWER
        gnd -- gnd,
        vcc -- power_5v
    DATA
        i2c[slave_address=0x76] sda sda -- d2, scl scl -- d1
    @ "my_wemos.sensors.env.bme680";

ALERT fever_alert ON BME WHEN temperature > 38.5
    THEN
        PUBLISH "my_wemos.alerts.fever"
    COOLDOWN 60 hz;

ALERT humid_alert ON BME WHEN humidity > 75.0
    THEN
        PUBLISH "my_wemos.alerts.humidity"
    COOLDOWN 30 hz;
