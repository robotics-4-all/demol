DEVICE EspSHTC3 WITH description="ESP32 SHTC3 temp/humidity", author="demol", os=riotos;
USE WemosD1R32;
USE SHTC3[MyEnv];
NETWORK[WiFi] WITH ssid="test", password="test123";
BROKER[MQTT] Local WITH host="localhost", port=1883;
CONNECT MyEnv WITH
    POWER GND -- GND, VCC -- VCC_3V3
    DATA i2c[slave_address=0x70] sda sda -- SDA, scl scl -- SCL;
