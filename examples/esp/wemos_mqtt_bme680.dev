// Zephyr MQTT + BME680 example — Wemos D1 R32 + BME680 with MQTT broker + SAMPLING.
//
// Demonstrates a full Zephyr RTOS IoT scenario: a BME680 environmental sensor
// is read continuously over I2C, with MQTT broker connectivity for data
// publication. The generated Zephyr application skeleton includes the
// devicetree overlay, prj.conf, main.c, and the BME680 driver source.
//
// This example is exercised by the Zephyr CI build matrix
// (.github/workflows/zephyr-build.yml).

DEVICE WemosMQTTBME680 WITH
    description="Wemos + BME680 with MQTT",
    author="demol",
    os=zephyr;

USE WemosD1R32;
USE BME680[MyBME];

NETWORK[WiFi] WITH
    ssid="test",
    password="test123";

BROKER[MQTT] Local WITH
    host="localhost",
    port=1883;

CONNECT MyBME WITH
    POWER
        gnd -- GND,
        vcc -- VCC_5V
    DATA
        i2c[slave_address=0x76] sda sda -- SDA, scl scl -- SCL
    @ "my_wemos.sensors.env.bme680";

SAMPLING MyBME WITH rate=10 hz, mode=continuous;
