DEVICE WemosButton WITH description="Wemos D1 Mini with a tactile button (RIOT)", author="demol";

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] MyMqttBroker WITH host="node.mqtt.local", port=1883, auth.username="guest", auth.password="guest";

USE WemosD1Mini;
USE TactileButton[Btn];

CONNECT Btn WITH
    POWER
        gnd -- gnd
    DATA
        gpio[mode="input"] state -- d2
    @ "my_wemos.sensors.button.tactile";
