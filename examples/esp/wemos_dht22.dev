DEVICE WemosDHT22 WITH description="Wemos D1 Mini with DHT22 temperature and humidity sensor", author="demol";

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] MyMqttBroker WITH host="node.mqtt.local", port=1883, auth.username="guest", auth.password="guest";

USE WemosD1Mini;
USE DHT22[Env];

CONNECT Env WITH
    POWER
        GND -- gnd,
        VCC -- power_3v3
    DATA
        gpio data -- d3
    @ "my_wemos.sensors.env.dht22";
