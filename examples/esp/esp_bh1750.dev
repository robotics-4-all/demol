DEVICE ESPBH1750 WITH description="ESP-based BH1750 I2C light sensor test device", author="klpanagi";

NETWORK[WiFi] WITH ssid="Wifi_2.4GHz", password="guest";

BROKER[MQTT] MyMqttBroker WITH host="node.mqtt.local", port=1883, auth.username="guest", auth.password="guest";

USE ESP32Wroom32;
USE BH1750[LIGHT];

CONNECT LIGHT WITH
    POWER
        GND -- GND_1,
        VCC -- VCC_3V3
    DATA
        i2c[slave_address=0x23] sda sda -- GPIO21, scl scl -- GPIO22
    @ "my_esp.sensors.light.bh1750";
