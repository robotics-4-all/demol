DEVICE WemosADS1115 WITH description="Wemos + ADS1115 ADC", author="demol", os=zephyr;
USE WemosD1R32;
USE ADS1115[MyADC];
NETWORK[WiFi] WITH ssid="test", password="test123";
BROKER[MQTT] Local WITH host="localhost", port=1883;
CONNECT MyADC WITH
    POWER GND -- GND, VCC -- VCC_3V3
    DATA i2c[slave_address=0x48] sda sda -- SDA, scl scl -- SCL;
