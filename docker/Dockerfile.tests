FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    make \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir flake8 black mypy

# Copy the source code
COPY . .

# Install the package with test extras (pulls in pytest, pytest-cov, commlib-py
# for end-to-end tests that exec generated RPi modules).
RUN pip install --no-cache-dir -e ".[test]"

# Default: run full CI pipeline
CMD ["make", "ci-check"]
