SENSOR[Distance] SRF05 WITH
    OP
        vcc=5V,
        ioVcc=5V,
        power.min=10 mW,
        power.max=100 mW,
        power.avg=75 mW
    PINS
        VCC[5V] @ 1,
        echo[gpio] @ 2,
        trigger[gpio] @ 3,
        GND[GND] @ 5
    TEMPLATES
        raspbian="srf05.py.j2",
        riotos="srf05_riot.c.j2"
    ATTRIBUTES
        frequency[float] = 10
;