SENSOR[Distance] SRF05 WITH
    OP
        vcc=5V,
        ioVcc=5V,
        power.min=10 mW,
        power.max=100 mW,
        power.avg=75 mW
    PINS
        VCC[5V] @ 1,
        echo[gpio] @ 2,
        trigger[gpio] @ 3,
        GND[GND] @ 5
    PROPERTIES
        // RIOT srf04 driver (re-used for SRF05) returns distance in mm.
        distance -> "dist" : int32 FOR riotos
    TEMPLATES
        raspbian="srf05.py.j2",
        riotos="srf05_riot.c.j2",
        zephyr="srf05.c.j2"
    DEPENDENCIES
        raspbian=["gpiozero", "pigpio"],
        riotos=["srf04"],
        zephyr=["gpio"]
    ATTRIBUTES
        gpio_modes[dict] = {trigger = "output", echo = "input"},
        frequency[float] = 10
;