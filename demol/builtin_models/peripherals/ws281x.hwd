// RIOT Configuration for ws2812 neopixel led strip

ACTUATOR[LedArray] WS281X WITH
    OP
        vcc=5V,
        power.min=5 mW,
        power.max=300 mW,
        power.avg=150 mW
    PINS
        vcc[5V] @ 1,
        gnd[GND] @ 2,
        data_in[gpio] @ 3,
        data_out[gpio] @ 4
    TEMPLATES
        raspbian="ws281x.py.j2",
        riotos="ws281x_riot.c.j2"
    DEPENDENCIES
        riotos=["ws281x"]
;
