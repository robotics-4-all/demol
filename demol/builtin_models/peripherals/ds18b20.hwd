SENSOR[Temperature] DS18B20 WITH
    OP
        vcc=3V3,
        ioVcc=3V3,
        power.min=0.5 mW,
        power.max=7.5 mW,
        power.avg=4 mW,
        freq.max=1 hz
    PINS
        GND[GND] @ 1,
        data[gpio] @ 2,
        VCC[3V3] @ 3
    TEMPLATES
        raspbian="ds18b20.py.j2"
    DEPENDENCIES
        raspbian=[
            {package="w1thermsensor", source="pip"}
        ]
    ATTRIBUTES
        gpio_modes[dict] = {data = "input"},
        frequency[float] = 1.0,
        resolution[int] = 12,
        unit[str] = "celsius"
;
