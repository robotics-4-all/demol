// RIOT Configuration for MPL3115A2 pressure sensor

SENSOR[Env] Mpl3115a2 WITH
    OP
        vcc=3V3,
        power.min=0.01 mW,
        power.max=10 mW,
        power.avg=2 mW
    PINS
        vcc[3V3] @ 1,
        gnd[GND] @ 2,
        scl[scl-0] @ 5,
        sda[sda-0] @ 6
    TEMPLATES
        raspbian="mpl3115a2.py.j2",
        riotos="mpl3115a2_riot.c.j2"
    DEPENDENCIES
        riotos=["mpl3115a2"]
    ATTRIBUTES
        i2c_address[int] = 96
;
