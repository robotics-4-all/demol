SENSOR[Proximity] PIR_HCSR501 WITH
    OP
        vcc=5V,
        ioVcc=3V3,
        power.min=30 mW,
        power.max=75 mW,
        power.avg=50 mW,
        freq.max=10 hz
    PINS
        vcc[5V] @ 1,
        out[gpio] @ 2,
        gnd[GND] @ 3
    PROPERTIES
        motion  -> "state" : int32 FOR riotos,
        state   -> "state" : int32 FOR riotos,
        // Zephyr PIR driver returns motion via a bool* parameter.
        // The alert codegen references `motion` directly.
        motion  -> "motion" : bool FOR zephyr
    TEMPLATES
        raspbian="pir_hcsr501.py.j2",
        riotos="pir_hcsr501.c.j2",
        zephyr="pir_hcsr501.c.j2"
    DEPENDENCIES
        raspbian=["gpiozero"],
        zephyr=["pir_hcsr501"]
    ATTRIBUTES
        gpio_modes[dict] = {OUT = "input"},
        frequency[float] = 10.0,
        hold_time[float] = 1.0
;
