ACTUATOR[ServoController] PCA9685 WITH
    OP
        vcc=5V,
        ioVcc=5V,
        power.min=10 mW,
        power.max=500 mW,
        power.avg=100 mW,
        freq.max=1600 hz
    PINS
        GND_1[GND] @ 1,
        SCL_1[scl-0] @ 2,
        SDA_1[sda-0] @ 3,
        VCC_1[5V] @ 4,
        Vplus_1[5V] @ 5,
        GND_2[GND] @ 6,
        SCL_2[scl-0] @ 7,
        SDA_2[sda-0] @ 8,
        VCC_2[5V] @ 9,
        Vplus_2[5V] @ 10,
        Vplus_get[5V] @ 11,
        GND_3[GND] @ 12,
        PWM_CH0[pwm-0] @ 13,
        Vplus_CH0[5V] @ 14,
        GND_CH0[GND] @ 15,
        PWM_CH1[pwm-1] @ 16,
        Vplus_CH1[5V] @ 17,
        GND_CH1[GND] @ 18,
        PWM_CH2[pwm-2] @ 19,
        Vplus_CH2[5V] @ 20,
        GND_CH2[GND] @ 21,
        PWM_CH3[pwm-3] @ 22,
        Vplus_CH3[5V] @ 23,
        GND_CH3[GND] @ 24,
        PWM_CH4[pwm-4] @ 25,
        Vplus_CH4[5V] @ 26,
        GND_CH4[GND] @ 27,
        PWM_CH5[pwm-5] @ 28,
        Vplus_CH5[5V] @ 29,
        GND_CH5[GND] @ 30,
        PWM_CH6[pwm-6] @ 31,
        Vplus_CH6[5V] @ 32,
        GND_CH6[GND] @ 33,
        PWM_CH7[pwm-7] @ 34,
        Vplus_CH7[5V] @ 35,
        GND_CH7[GND] @ 36,
        PWM_CH8[pwm-8] @ 37,
        Vplus_CH8[5V] @ 38,
        GND_CH8[GND] @ 39,
        PWM_CH9[pwm-9] @ 40,
        Vplus_CH9[5V] @ 41,
        GND_CH9[GND] @ 42,
        PWM_CH10[pwm-10] @ 43,
        Vplus_CH10[5V] @ 44,
        GND_CH10[GND] @ 45,
        PWM_CH11[pwm-11] @ 46,
        Vplus_CH11[5V] @ 47,
        GND_CH11[GND] @ 48,
        PWM_CH12[pwm-12] @ 49,
        Vplus_CH12[5V] @ 50,
        GND_CH12[GND] @ 51,
        PWM_CH13[pwm-13] @ 52,
        Vplus_CH13[5V] @ 53,
        GND_CH13[GND] @ 54,
        PWM_CH14[pwm-14] @ 55,
        Vplus_CH14[5V] @ 56,
        GND_CH14[GND] @ 57,
        PWM_CH15[pwm-15] @ 58,
        Vplus_CH15[5V] @ 59,
        GND_CH15[GND] @ 60
    TEMPLATES
        raspbian="pca9685.py.j2",
        riotos="pca9685_riot.c.j2"
    DEPENDENCIES
        raspbian=["adafruit-circuitpython-pca9685", "adafruit-circuitpython-motor"]
    ATTRIBUTES
        channels[int] = 16,
        frequency[int] = 50
;
