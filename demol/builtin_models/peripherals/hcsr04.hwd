SENSOR[Distance] HCSR04 WITH
    OP
        vcc=5V,
        ioVcc=5V,
        power.min=10 mW,
        power.max=100 mW,
        power.avg=75 mW
    PINS
        GND[GND] @ 1,
        echo[gpio] @ 2,
        trigger[gpio] @ 3,
        VCC[5V] @ 4
    TEMPLATES
        raspbian="hcsr04.py.tmpl",
        riotos="hcsr04.c.tmpl"
    ATTRIBUTES
        frequency[float] = 10
;
