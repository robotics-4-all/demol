// Single Tactile Button model

ACTUATOR[Button] TactileButton WITH
    OP
        vcc=5V,
        power.min=0 mW,
        power.max=1 mW,
        power.avg=0.5 mW
    PINS
        gnd[GND] @ 1,
        state[gpio] @ 2
    TEMPLATES
        raspbian="button.py.tmpl",
        riotos="button.c.tmpl"
;
