SENSOR[Distance] VL53L1X WITH
    OP
        vcc=3V3, //According to the datasheet it is 2.6-5.5V
        ioVcc=3V3,
        power.min=5 mW,
        power.max=60 mW,
        power.avg=20 mW,
        freq.max=50 hz
    PINS
        ?VDD[2.8V] @ 1,
        VIN[3V3] @ 2,
        GND[GND] @ 3,
        SDA[sda-0] @ 4,
        SCL[scl-0] @ 5,
        ?XSHUT[gpio] @ 6,
        ?GPIO1[gpio] @ 7
    TEMPLATES
        raspbian="vl53l1x.py.j2"
    DEPENDENCIES
        raspbian=["vl53l1x"]
    ATTRIBUTES
        i2c_address[int] = 41
;