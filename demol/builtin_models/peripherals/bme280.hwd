SENSOR[Env] BME280 WITH
    OP
        vcc=3V3,
        ioVcc=3V3,
        power.min=0.1 mW,
        power.max=3.6 mW,
        power.avg=1.0 mW
    PINS
        VCC[3V3] @ 1,
        GND[GND] @ 2,
        sda[sda-0] @ 3,
        scl[scl-0] @ 4,
        ? sdo[gpio] @ 5,
        ? csb[cs-0] @ 6
    TEMPLATES
        raspbian="bme280.py.j2"
    DEPENDENCIES
        raspbian=[
            {package="adafruit-circuitpython-bme280", source="pip"}
        ]
    ATTRIBUTES
        i2c_address[int] = 118,
        poll_period[int] = 10,
        temperature_oversample[int] = 2,
        pressure_oversample[int] = 4,
        humidity_oversample[int] = 1,
        filter_coefficient[int] = 2
;
