SENSOR[Gas] CCS811 WITH
    OP
        vcc=3V3,
        ioVcc=3V3,
        power.min=1.2 mW,
        power.max=46 mW,
        power.avg=19 mW
    PINS
        VCC[3V3] @ 1,
        GND[GND] @ 2,
        sda[sda-0] @ 3,
        scl[scl-0] @ 4,
        ? ADDR[gpio] @ 5,
        ? WAKE[gpio] @ 6,
        ? INT[gpio] @ 7,
        ? RST[gpio] @ 8
    TEMPLATES
        raspbian="ccs811.py.j2"
    DEPENDENCIES
        raspbian=[
            {package="adafruit-circuitpython-ccs811", source="pip"}
        ]
    ATTRIBUTES
        i2c_address[int] = 90,
        drive_mode[int] = 1,
        poll_period[int] = 1
;
