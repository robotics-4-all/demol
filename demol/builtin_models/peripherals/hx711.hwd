SENSOR[Weight] HX711 WITH
    OP
        vcc=5V,
        ioVcc=3V3,
        power.min=1.0 mW,
        power.max=5.0 mW,
        power.avg=2.5 mW
    PINS
        VCC[5V] @ 1,
        GND[GND] @ 2,
        DT[gpio] @ 3,
        SCK[gpio] @ 4
    TEMPLATES
        raspbian="hx711.py.j2"
    DEPENDENCIES
        raspbian=[
            {package="hx711", source="pip"}
        ]
    ATTRIBUTES
        gain[int] = 128,
        poll_period[int] = 1,
        reference_unit[float] = 1.0,
        tare_offset[float] = 0.0
;
