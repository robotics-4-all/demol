SENSOR[Proximity] HW006 WITH
    OP
        vcc=5V,
        power.min=0 mW,
        power.max=5 mW,
        power.avg=2 mW
    PINS
        DO[gpio] @ 1,
        VCC[5V] @ 2,
        GND[GND] @ 3
    TEMPLATES
        raspbian="hw006.py.tmpl",
        riotos="hw006.c.tmpl"
    ATTRIBUTES
        frequency[int] = 100
;