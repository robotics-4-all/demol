SENSOR[Proximity] HW006 WITH
    OP
        vcc=5V,
        power.min=0 mW,
        power.max=5 mW,
        power.avg=2 mW
    PINS
        DO[gpio] @ 1,
        vcc[5V] @ 2,
        gnd[GND] @ 3
    PROPERTIES
        // HW006 RIOT template reads gpio into local `val` (0/1).
        proximity -> "val" : int32 FOR riotos
    TEMPLATES
        raspbian="hw006.py.j2",
        riotos="hw006.c.j2",
        zephyr="hw006.c.j2"
    DEPENDENCIES
        raspbian=["gpiozero"]
    ATTRIBUTES
        frequency[int] = 100
;
