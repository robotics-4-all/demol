// Text-to-Speech Speaker model
ACTUATOR[Speaker] TTSSpeaker WITH
    OP
        vcc=5V,
        ioVcc=3V3,
        power.min=100 mW,
        power.max=1000 mW,
        power.avg=300 mW,
        freq.max=1 hz
    PINS
        gnd[GND] @ 1
    TEMPLATES
        raspbian="tts.py.j2"
    ATTRIBUTES
        rate[int] = 150,
        volume[float] = 1.0,
        voice[str] = "english-us"
;
