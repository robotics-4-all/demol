SENSOR[Env] BME680 WITH
    OP
        vcc=5V,
        ioVcc=3V3,
        power.min=0.01 mW,
        power.max=39.6 mW,
        power.avg=3 mW
    PINS
        vcc[5V] @ 1,
        gnd[GND] @ 5,
        sda[sda-0] @ 2,
        scl[scl-0] @ 3
    TEMPLATES
        raspbian="bme680.py.j2",
        riotos="bme680.c.j2"
    DEPENDENCIES
        raspbian=["bme680"],
        riotos=["bme680"]
    ATTRIBUTES
        poll_period[int] = 10,
        humidity_oversample[int] = 2,
        pressure_oversample[int] = 4,
        temperature_oversample[int] = 8,
        filter_size[int] = 3,
        gas_status[str] = "ENABLE_GAS_MEAS",
        heater_temp[int] = 320,
        heater_duration[int] = 150,
        heater_profile[int] = 0
;