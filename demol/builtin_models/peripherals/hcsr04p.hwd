SENSOR[Distance] HCSR04P WITH
    OP
        vcc=3V3,
        ioVcc=3V3,
        power.min=10 mW,
        power.max=100 mW,
        power.avg=75 mW,
        freq.max=100 hz
    PINS
        GND[GND] @ 1,
        echo[gpio] @ 2,
        trigger[gpio] @ 3,
        VCC[3V3] @ 4
    TEMPLATES
        raspbian="hcsr04.py.j2",
        riotos="hcsr04.c.j2"
    ATTRIBUTES
        frequency[float] = 10,
        threshold_distance[float] = 0.3
;
