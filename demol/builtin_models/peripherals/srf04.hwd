SENSOR[Distance] SRF04 WITH
    OP
        vcc=5V,
        ioVcc=5V,
        power.min=10 mW,
        power.max=100 mW,
        power.avg=75 mW
    PINS
        vcc[5V] @ 1,
        gnd[GND] @ 4,
        trigger[gpio] @ 2,
        echo[gpio] @ 3
    TEMPLATES
        raspbian="srf04.py.j2",
        riotos="srf04_riot.c.j2"
;
