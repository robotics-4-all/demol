// Model of NeoPixel_Ring_12
ACTUATOR[LedArray] WS2812 WITH
    OP
        vcc=5V,
        power.min=5 mW,
        power.max=3600 mW,
        power.avg=1800 mW
    PINS
        VCC[5V] @ 1,
        GND[GND] @ 2,
        DIN[gpio,mosi-0] @ 3
    TEMPLATES
        raspbian="ws2812.py.j2",
        riotos="ws2812_riot.c.j2"
    ATTRIBUTES
        num_leds[int] = 12,
        color_format[str] = "GRB",
        brightness[float] = 0.5
;