BOARD[ESP] WemosD1Mini WITH
    OP
        vcc=5V,
        ioVcc=3V3,
        memory.flash=16 mb,
        cpu.family=ESP8266,
        cpu.freq=160 mhz,
        cpu.fpu=false,
        wifi.name=Wemos_WiFi,
        wifi.version=4,
        wifi.bands=[2.4GHz],
        power.min=2 mW,
        power.max=500 mW,
        power.avg=80 mW
    PORTS
        spi=1,
        i2c=1,
        uart=1,
        gpio=9
    PINS
        rst[] @ 1,
        a0[adc] @ 2,
        d0[gpio] @ 3,
        d5[gpio,sck-0] @ 4,
        d6[gpio,miso-0] @ 5,
        d7[gpio,mosi-0] @ 6,
        d8[gpio,cs-0] @ 7,
        power_3v3[3V3] @ 8,
        tx[tx-0] @ 9,
        rx[rx-0] @ 10,
        d1[gpio,scl-0] @ 11,
        d2[gpio,sda-0] @ 12,
        d3[gpio] @ 13,
        d4[gpio] @ 14,
        gnd[GND] @ 15,
        power_5v[5V] @ 16
    PLATFORMS
        riotos.board = "esp8266-esp-12x"

;
