BOARD[ESP] ESP32Wroom32 WITH
    OP
        vcc=3V3,
        ioVcc=3V3,
        memory.flash=4 mb,
        cpu.family=ESP32,
        cpu.freq=240 mhz,
        cpu.fpu=false,
        wifi.name=wlan0,
        wifi.version=4,
        wifi.bands=[2.4GHz],
        bluetooth=BT4,
        power.min=2.64 mW,
        power.max=792 mW,
        power.avg=100 mW
    PORTS
        spi=2,
        i2c=1,
        uart=2,
        gpio=33
    PINS
        VCC_3V3[3V3] @ 1,
        EN[gpio] @ 2,
        GPIO36[gpio,adc] @ 3,
        GPIO39[gpio,adc] @ 4,
        GPIO34[gpio,adc] @ 5,
        GPIO35[gpio,adc] @ 6,
        GPIO32[gpio,pwm-1,adc] @ 7,
        GPIO33[gpio,pwm-1,adc] @ 8,
        GPIO25[gpio,dac,adc] @ 9,
        GPIO26[gpio,dac,adc] @ 10,
        GPIO27[gpio,pwm-1,adc] @ 11,
        GPIO14[gpio,sck-1,adc] @ 12,
        GPIO12[gpio,miso-1,adc] @ 13,
        GND_1[GND] @ 14,
        GPIO13[gpio,mosi-1,adc] @ 15,
        GPIO9[gpio,rx-1] @ 16,
        GPIO10[gpio,tx-1] @ 17,
        GPIO11[gpio] @ 18,
        VCC_5V[5V] @ 19,
        GND_2[GND] @ 20,
        GPIO23[gpio,mosi-0] @ 21,
        GPIO22[gpio,scl-0] @ 22,
        GPIO1[gpio,tx-0] @ 23,
        GPIO3[gpio,rx-0] @ 24,
        GPIO21[gpio,sda-0] @ 25,
        GND_3[GND] @ 26,
        GPIO19[gpio,miso-0] @ 27,
        GPIO18[gpio,sck-0] @ 28,
        GPIO5[gpio,cs-0] @ 29,
        GPIO17[gpio,pwm-0] @ 30,
        GPIO16[gpio,pwm-0] @ 31,
        GPIO4[gpio,pwm-0,adc] @ 32,
        GPIO0[gpio,pwm-0,adc] @ 33,
        GPIO2[gpio,pwm-0,adc] @ 34,
        GPIO15[gpio,cs-1,adc] @ 35,
        GPIO8[gpio] @ 36,
        GPIO7[gpio] @ 37,
        GPIO6[gpio] @ 38
;
