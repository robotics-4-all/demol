BOARD[RPI] RaspberryPi_3A_Plus WITH
    OP
        vcc=5V,
        memory.flash=16 gb,
        memory.ram=512 mb,
        cpu.family=PiArmCortex,
        cpu.freq=1400 mhz,
        cpu.fpu=true,
        wifi.name=RPi3_WiFi,
        wifi.version=5,
        wifi.bands=[2.4GHz, 5GHz],
        bluetooth=BT4,
        ioVcc=3V3,
        power.min=1.5 W,
        power.max=4.5 W,
        power.avg=2.5 W
    PORTS
        spi=1,
        i2c=2,
        uart=1,
        gpio=28
    PINS
        power_3v3_a[3V3] @ 1,
        power_5v_a[5V] @ 2,
        GPIO2[gpio,sda-0] @ 3,
        power_5v_b[5V] @ 4,
        GPIO3[gpio,scl-0] @ 5,
        GND_1[GND] @ 6,
        GPIO4[gpio] @ 7,
        GPIO14[gpio,tx-0] @ 8,
        GND_2[GND] @ 9,
        GPIO15[gpio,rx-0] @ 10,
        GPIO17[gpio] @ 11,
        GPIO18[gpio,pwm-0] @ 12,
        GPIO27[gpio] @ 13,
        GND_3[GND] @ 14,
        GPIO22[gpio] @ 15,
        GPIO23[gpio] @ 16,
        power_3v3_b[3V3] @ 17,
        GPIO24[gpio] @ 18,
        GPIO10[gpio,mosi-0] @ 19,
        GND_4[GND] @ 20,
        GPIO9[gpio,miso-0] @ 21,
        GPIO25[gpio] @ 22,
        GPIO11[gpio,sck-0] @ 23,
        GPIO8[gpio,cs-0] @ 24,
        GND_5[GND] @ 25,
        GPIO7[gpio,cs-1] @ 26,
        ID_SD[gpio,sda-1] @ 27,
        ID_SC[gpio,scl-1] @ 28,
        GPIO5[gpio] @ 29,
        GND_6[GND] @ 30,
        GPIO6[gpio] @ 31,
        GPIO12[gpio,pwm-0] @ 32,
        GPIO13[gpio,pwm-1] @ 33,
        GND_7[GND] @ 34,
        GPIO19[gpio] @ 35,
        GPIO16[gpio] @ 36,
        GPIO26[gpio] @ 37,
        GPIO20[gpio] @ 38,
        GND_8[GND] @ 39,
        GPIO21[gpio] @ 40
;
