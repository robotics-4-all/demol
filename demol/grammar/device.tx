// Grammar for a system. A system consists a board
// and one or more peripherals (sensors/actuators).

import component
import communication
import common

DeviceModel:
    imports*=Import
    (
        metadata=Device
        network=Network
        uses+=Use
        (broker=MessageBroker)?
        connections+=Connect
    )#
;

Device:
    'DEVICE' name=ID 'WITH'
    (
        ('description' '=' description=STRING)
        ('author' '=' author=STRING)
        ('os' '=' os=OperatingSystem)?
    )#[',']
    ';'
;

Network: WiFiNetwork | EthNetwork;


WiFiNetwork:
    /[Nn][Ee][Tt][Ww][Oo][Rr][Kk]/ '[' 'WiFi' ']' /[Ww][Ii][Tt][Hh]/
    (
        ('ssid' '=' ssid=STRING)
        ('password' '=' passwd=STRING)
        ('address' '=' address=IP_ADDR)?
        ('channel' '=' channel=STRING)?
    )#[',']
    ';'
;

EthNetwork:
    /[Nn][Ee][Tt][Ww][Oo][Rr][Kk]/ '[' 'Eth' ']'
    (
        /[Ww][Ii][Tt][Hh]/
        (
            ('address' '=' address=IP_ADDR)?
        )#[',']
    )?
    ';'
;


Use:
    "USE" (peripherals+=PeripheralDef[','] | board=[Board:FQN|+m:component]) ';'
;

PeripheralDef:
    ref=[Peripheral:FQN|+m:component] '[' name=ID ']' ('WITH' attributes*=AttributeSet[','])?
;

Connect:
	/[Cc][Oo][Nn][Nn][Ee][Cc][Tt]/ peripheral=[PeripheralDef:FQN|~uses.peripherals] /[Ww][Ii][Tt][Hh]/
	(
	    (/[Pp][Oo][Ww][Ee][Rr]/ powerConns*=PowerConnection[','])?
        (/[Dd][Aa][Tt][Aa]/ dataConns+=DataConnection[','])?
	    ("@" remote=STRING)?
    )#
    ';'
;

PinConnection:
    boardPin=ID "--" peripheralPin=ID
;

PowerConnection: PinConnection;

DataConnection:
    GPIOConnection | I2CConnection | SPIConnection | UARTConnection
;

GPIOConnection:
    type='gpio' ('[' props*=AttributeSet[','] ']')? pins+=PinConnection[',']
;

I2CConnection:
    type='i2c' ('[' props*=AttributeSet[','] ']')? pins+=PinMapping[',']
;

SPIConnection:
    type='spi' ('[' props*=AttributeSet[','] ']')? pins+=PinMapping[',']
;

UARTConnection:
    type='uart' ('[' props*=AttributeSet[','] ']')? pins+=PinMapping[',']
;

PinMapping:
    (function=ID boardPin=ID '--' peripheralPin=ID)
;