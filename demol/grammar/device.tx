// Grammar for a system. A system consists a board
// and one or more peripherals (sensors/actuators).

import component
import communication
import common

DeviceModel:
    imports*=Import
    (
        metadata=Device
        uses+=Use
        (network=Network)?
        brokers*=MessageBroker
        connections*=Connect
        smartConnections*=SmartConnect
        samplings*=SamplingConfig
        constraints*=UserConstraint
        alerts*=AlertTrigger
    )#
;

Device:
    'DEVICE' name=ID 'WITH'
    (
        ('description' '=' description=STRING)
        ('author' '=' author=STRING)
        ('os' '=' os=OperatingSystem)?
    )#[',']
    ';'
;

Network: WiFiNetwork | EthNetwork;


WiFiNetwork:
    /[Nn][Ee][Tt][Ww][Oo][Rr][Kk]/ '[' 'WiFi' ']' /[Ww][Ii][Tt][Hh]/
    (
        ('ssid' '=' ssid=STRING)
        ('password' '=' passwd=STRING)
        ('address' '=' address=IP_ADDR)?
        ('channel' '=' channel=STRING)?
    )#[',']
    ';'
;

EthNetwork:
    /[Nn][Ee][Tt][Ww][Oo][Rr][Kk]/ '[' 'Eth' ']'
    (
        /[Ww][Ii][Tt][Hh]/
        (
            ('address' '=' address=IP_ADDR)?
        )#[',']
    )?
    ';'
;


Use:
    "USE" components+=ComponentInstance (',' components+=ComponentInstance)* ';'
;

ComponentInstance:
    ref=[Component:FQN|+m:component] ('[' name=ID ']')? ('WITH' attributes*=AttributeSet[','])?
;

Connect:
	'CONNECT' from_comp=[ComponentInstance:FQN] (':' to_comp=[ComponentInstance:FQN])? 'WITH'
	(
	    ('POWER' powerConns*=PowerConnection[','])?
        ('DATA' dataConns+=DataConnection[','])?
	    ("@" remote=STRING)?
	    ('VIA' via=ID)?
    )#
    ';'
;

SmartConnect:
    'SMARTCONNECT' target=[ComponentInstance:FQN] ("@" remote=STRING)? ('VIA' via=ID)? ';'
;

PinConnection:
    fromPin=ID "--" toPin=ID
;

PowerConnection: PinConnection;

DataConnection:
    GPIOConnection | I2CConnection | SPIConnection | UARTConnection | PWMConnection
;

GPIOConnection:
    type='gpio' ('[' props*=AttributeSet[','] ']')? pins+=PinConnection[',']
;

I2CConnection:
    type='i2c' ('[' props*=AttributeSet[','] ']')? pins+=PinMapping[',']
;

SPIConnection:
    type='spi' ('[' props*=AttributeSet[','] ']')? pins+=PinMapping[',']
;

UARTConnection:
    type='uart' ('[' props*=AttributeSet[','] ']')? pins+=PinMapping[',']
;

PWMConnection:
    type='pwm' ('[' props*=AttributeSet[','] ']')? pins+=PinConnection[',']
;

PinMapping:
    (function=ID fromPin=ID '--' toPin=ID)
;


// ========================================================================
// Sampling Configuration
// ========================================================================

SamplingConfig:
    'SAMPLING' target=[ComponentInstance:FQN] 'WITH'
    (
        ('rate' '=' rate=NUMBER rate_unit=FrequencyUnit)
        ('mode' '=' mode=SamplingMode)?
        ('buffer' '=' buffer=INT)?
        ('threshold' '=' threshold=NUMBER)?
    )#[',']
    ';'
;

SamplingMode:
    'continuous' | 'on_change' | 'on_demand' | 'batch'
;


// ========================================================================
// User-Defined Constraints
// ========================================================================

UserConstraint:
    'CONSTRAINT' name=ID ':' expr=ConstraintExpr
    ('MESSAGE' message=STRING)?
    ';'
;

ConstraintExpr:
    ComparisonExpr
;

ComparisonExpr:
    left=AdditiveExpr op=ComparisonOp right=AdditiveExpr
;

ComparisonOp:
    '<=' | '>=' | '!=' | '==' | '<' | '>'
;

AdditiveExpr:
    operands=UnaryExpr (operators=AdditiveOp operands=UnaryExpr)*
;

AdditiveOp:
    '+' | '-'
;

UnaryExpr:
    MultiplicativeExpr
;

MultiplicativeExpr:
    operands=AtomExpr (operators=MultiplicativeOp operands=AtomExpr)*
;

MultiplicativeOp:
    '*' | '/'
;

AtomExpr:
    FunctionCallExpr | PropertyAccessExpr | NumberLiteral | StringLiteral | BoolLiteral
;

FunctionCallExpr:
    func=BuiltinFunc '(' arg=FunctionArg ')'
;

BuiltinFunc:
    'count' | 'sum_power' | 'avg_power' | 'max_power'
;

FunctionArg:
    'SENSOR' | 'ACTUATOR' | 'PERIPHERAL' | 'CONNECTION'
;

PropertyAccessExpr:
    segments+=ID['.']
;

NumberLiteral:
    value=NUMBER (unit=ConstraintUnit)?
;

ConstraintUnit:
    PowerUnit | CapacityUnit | CurrentUnit | FrequencyUnit
;

StringLiteral:
    value=STRING
;

BoolLiteral:
    value=BOOL
;


// ========================================================================
// Alert Triggers
// ========================================================================

AlertTrigger:
    'ALERT' name=ID 'ON' source=[ComponentInstance:FQN]
    'WHEN' condition=AlertConditionExpr
    'THEN' actions+=AlertAction
    ('COOLDOWN' cooldown=NUMBER cooldown_unit=FrequencyUnit)?
    ';'
;

AlertConditionExpr:
    left=AlertComparison (op=AlertLogicOp right=AlertConditionExpr)?
;

AlertLogicOp:
    '&&' | '||'
;

AlertComparison:
    property=ID op=ComparisonOp value=NUMBER (unit=ConstraintUnit)?
;

AlertAction:
    AlertPublish | AlertActivate
;

AlertPublish:
    'PUBLISH' topic=STRING ('VIA' via=ID)?
;

AlertActivate:
    'ACTIVATE' target=[ComponentInstance:FQN]
;