import common

//Device
ComponentModel:
    component=Component
;

Component:
    Board | Peripheral | PowerSource
;

BoardType:
    'RPI' |
	'ESP' |
	'ARDUINO'
;

Board:
    'BOARD' '[' type=BoardType ']' name=ID 'WITH'
	  'OP' operational=OperationalBoard
      ('PORTS' ports*=Port[','])?
	  'PINS' pins*=Pin[',']
      ('PLATFORMS' platforms*=PlatformMapping[','])?
    ';'
;

Port:
    name=ID '=' count=INT
;

Peripheral: Sensor | Actuator;


Actuator:
    'ACTUATOR' '[' type=ActuatorType ']' name=ID 'WITH'
	  'OP' operational=OperationalActuator
	  'PINS' pins*=Pin[',']
	  ('TEMPLATES' templates*=TemplateMapping[','])?
      ('DEPENDENCIES' dependencies*=DependencyMapping[','])?
      ('ATTRIBUTES' attributes*=Attribute[','])?
    ';'
;

PowerSource:
    'POWERSOURCE' '[' type=PowerSourceType ']' name=ID 'WITH'
	  'OP' operational=OperationalPowerSource
	  'PINS' pins*=Pin[',']
    ';'
;

PowerSourceType:
    'Battery' | 'DC' | 'USB' | 'Solar'
;

Sensor:
    'SENSOR' '[' type=SensorType ']' name=ID 'WITH'
	  'OP' operational=OperationalSensor
	  'PINS' pins*=Pin[',']
	  ('TEMPLATES' templates*=TemplateMapping[','])?
      ('DEPENDENCIES' dependencies*=DependencyMapping[','])?
      ('ATTRIBUTES' attributes*=Attribute[','])?
    ';'
;

DependencyMapping:
    target=OperatingSystem '=' '[' items+=DependencyItem[','] ']'
;

DependencyItem:
    DependencyObject | STRING
;

DependencyObject:
    '{'
        'package' '=' name=STRING ','?
        ('version' '=' version=STRING ','?)?
        ('source' '=' source=STRING)?
    '}'
;


Pin:
	PowerPin | IOPin
;

PowerPin:
	(optional='?')? name=ID '[' ptype=PowerType ']' '@' number=INT
;

PowerType:
	"GND"   |
    "5V"    |
    "3V3"   |
    "12V"   |
    Custom
;

Custom:
    /[0-9]+(\.[0-9]+)?V/
;

IOPin:
	(optional='?')? name=ID '[' funcs*=PinFunction[","] ']' '@' number=INT
;

PinFunction:
	GPIO | I2C | SPI | UART | PWM | ADC | DAC | PCM
;

GPIO:
	ptype="gpio"
;

I2C:
	ptype=I2C_TYPE "-" bus=INT
;

I2C_TYPE:
	"sda" | "scl"
;

SPI:
	ptype=SPIPinType "-" bus=INT
;

SPIPinType:
	"mosi" | "miso" | "sck" | "cs"
;

UART:
	ptype=UARTPinType "-" bus=INT
;

UARTPinType:
	"tx" | "rx"
;

PWM:
	ptype="pwm" ("-" channel=INT)?
;

ADC:
	ptype="adc" ("-" bus=INT)?
;

DAC:
	ptype="dac" ("-" bus=INT)?
;

PCM:
    ptype=PCMType ("-" bus=INT)?
;

PCMType:
    "fs" | "din" | "dout"
;


CPUFamilyType:
	("ESP32" | "ESP8266" | "PiArmCortex")
;

Bluetooth:
    'NA' |
    'BT3' |
    'BT4' |
    'BT5'
;


SensorType:
    EnvSensor | MotionSensor | OtherSensor
;

EnvSensor:
    "Temperature"   |
    "Humidity"      |
    "Gas"           |
    "Pressure"      |
    "Env"           |
    "AirQuality"    |
    "Light"         |
    "UV"            |
    "Sound"
;

MotionSensor:
    "Distance"      |
    "DistanceMatrix"|
    "Acceleration"  |
    "Gyroscope"     |
    "Magnetometer"  |
    "IMU"           |
    "Tracker"
;

OtherSensor:
    "ADC"           |
    "Proximity"     |
    "Button"
;

ActuatorType:
    MotorActuator | DisplayActuator | SoundActuator | AdvancedActuator
;

MotorActuator:
    "MotorController"   |
    "ServoController"   |
    "Relay"             |
    "Switch"
;

DisplayActuator:
    "LedArray"          |
    "Led"               |
    "NeoPixel"
;

SoundActuator:
    "Buzzer"            |
    "Speaker"
;

AdvancedActuator:
    "Stepper"           |
    "DCMotor"           |
    "Pump"              |
    "Valve"             |
    "Heater"            |
    "Cooler"            |
    "Fan"
;



// Operational blocks
OperationalBoard:
    (
        ("vcc" "=" vcc=PowerType ","?)
        ("ioVcc" "=" iovcc=PowerType ","?)?
        
        ("cpu.family" "=" cpu_family=CPUFamilyType ","?)?
        ("cpu.freq" "=" cpu_freq=NUMBER cpu_freq_unit=FrequencyUnit ","?)?
        ("cpu.fpu" "=" cpu_fpu=BOOL ","?)?
        
        ("memory.ram" "=" memory_ram=NUMBER memory_ram_unit=UNITS ","?)?
        ("memory.flash" "=" memory_flash=NUMBER memory_flash_unit=UNITS ","?)?
        ("memory.rom" "=" memory_rom=NUMBER memory_rom_unit=UNITS ","?)?
        
        ("wifi.name" "=" wifi_name=ID ","?)?
        ("wifi.version" "=" wifi_version=WifiVersion ","?)?
        ("wifi.bands" "=" "[" wifi_bands+=WifiBand[','] "]" ","?)?
        
        ("ethernet.name" "=" ethernet_name=ID ","?)?
        
        ("bluetooth" "=" bluetooth=Bluetooth ","?)?
        
        ("power.min" "=" min=PowerConsumption ","?)?
        ("power.max" "=" max=PowerConsumption ","?)?
        ("power.avg" "=" avg=PowerConsumption ","?)?
    )#
;

WifiVersion:
    '3' | '4' | '5' | '6' | '7'
;

WifiBand:
    '2.4GHz' | '5GHz' | '2.4Ghz' | '5Ghz'
;

OperationalSensor: OperationalPeripheral;

OperationalActuator: OperationalPeripheral;

OperationalPeripheral:
    (
        ("vcc" "=" vcc=PowerType ","?)
        ("ioVcc" "=" iovcc=PowerType ","?)?
        ("power.min" "=" min=PowerConsumption ","?)?
        ("power.max" "=" max=PowerConsumption ","?)?
        ("power.avg" "=" avg=PowerConsumption ","?)?
        ("freq.max" "=" freq_max=Frequency ","?)?
        ("riotTpl" "=" riotTpl=STRING ","?)?
        ("piTpl" "=" piTpl=STRING ","?)?
    )#
;

OperationalPowerSource:
    (
        ("voltage" "=" voltage=PowerType ","?)
        ("capacity" "=" capacity=NUMBER capacity_unit=CapacityUnit ","?)?
        ("max_current" "=" max_current=NUMBER max_current_unit=CurrentUnit ","?)?
    )#
;

PowerConsumption:
    value=NUMBER unit=PowerUnit
;

Frequency:
    value=NUMBER unit=FrequencyUnit
;

TemplateMapping:
    os=OperatingSystem '=' template=STRING
;

PlatformMapping:
    os=OperatingSystem '{'
        attributes*=AttributeSet[',']
    '}'
;

