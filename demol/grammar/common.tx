FQN: ID+['.'];
FQNI: ID+['.']('.*')?;
Import: 'import' importURI=FQNI ('as' name=ID)?;


// Special rule for comments. Comments start with //

Comment: CommentLine | CommentBlock ;

CommentLine: /\/\/.*?$/;

CommentBlock: /\/\*(.|\n)*?\*\//;


// Common Units
UNITS: ("kb" | "mb" | "gb" | "b");

FrequencyUnit: "ghz" | "mhz" | "khz" | "hz";


PowerUnit: "W" | "mW" | "uW";
CapacityUnit: "mAh" | "Ah" | "Wh";
CurrentUnit: "A" | "mA" | "uA";

// Network Addresses
IPv4_ADDR: /([0-9]{1,3}\.){3}[0-9]{1,3}/;
IPv6_ADDR: /([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}/;
IP_ADDR: IPv4_ADDR | IPv6_ADDR;

// Value types
VALUE: HEX | NUMBER | STRING | BOOL;

HEX: /0x[0-9a-fA-F]+/;

AttributeSet: name=ID '=' value=AttributeValue;

AttributeValue: ListValue | DictValue | VALUE;

ListValue: '[' items*=VALUE[','] ']';

DictValue: '{' items*=DictItem[','] '}';

DictItem: key=ID '=' value=AttributeValue;

// Attribute types
Attribute:
    NumericAttribute    |
    BoolAttribute       |
    StringAttribute     |
    ListAttribute       |
    DictAttribute
;

NumericAttribute:
    IntAttribute | FloatAttribute
;

IntAttribute:
    name=ID '[' type='int' ']' ('=' default=INT)?
;

FloatAttribute:
    name=ID '[' type='float' ']' ('=' default=FLOAT)?
;

StringAttribute:
    name=ID '[' type='str' ']' ('=' default=STRING)?
;

BoolAttribute:
    name=ID '[' type='bool' ']' ('=' default=BOOL)?
;

ListAttribute:
    name=ID '[' type='list' ']' ('=' default=ListValue)?
;

DictAttribute:
    name=ID '[' type='dict' ']' ('=' default=DictValue)?
;

OperatingSystem:
    'raspbian'      |
    'riotos'        |
    'zephyr'        |
    'arduino'       |
    'esp-idf-rtos'  |
    'esp-idf'
;