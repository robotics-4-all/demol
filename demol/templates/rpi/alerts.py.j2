"""Alert runtime helper for DeMoL-generated devices.

Generated by demol — do not edit by hand. Regenerate with:
    demol generate rpi <model>.dev --output-dir <out>

Each ``AlertTrigger`` evaluates a boolean expression over the latest sensor
sample and, when fired, publishes one or more actions over the broker the
trigger was bound to with ``VIA``. Cooldown is enforced in wall-clock seconds
(monotonic timer) so back-to-back samples cannot re-fire the same alert.
"""
import logging
import time
from typing import Any, Callable, Dict, List, Optional

from commlib.node import Node
from commlib.transports.mqtt import ConnectionParameters

logger = logging.getLogger(__name__)


class AlertTrigger:
    """One alert: condition + cooldown + action publishers.

    ``condition`` is a callable that receives the latest sample dict and
    returns True when the alert should fire. ``actions`` is a list of
    pre-bound zero-arg callables (each one publishes to the right broker on
    the right topic with the right payload).
    """

    def __init__(
        self,
        name: str,
        condition: Callable[[Dict[str, Any]], bool],
        actions: List[Callable[[], None]],
        cooldown_sec: float = 0.0,
    ) -> None:
        self.name = name
        self.condition = condition
        self.actions = actions
        self.cooldown_sec = float(cooldown_sec)
        self._last_fired_monotonic: Optional[float] = None

    def evaluate(self, data: Dict[str, Any]) -> bool:
        """Run the condition against ``data``; fire actions if it triggers.

        Returns True iff the alert fired this call. Property errors are
        logged and treated as a no-fire, never raised.
        """
        try:
            if not self.condition(data):
                return False
        except (KeyError, TypeError, ValueError) as exc:
            logger.warning("alert '%s' skipped: %s", self.name, exc)
            return False

        now = time.monotonic()
        if self._last_fired_monotonic is not None and self.cooldown_sec > 0.0:
            if (now - self._last_fired_monotonic) < self.cooldown_sec:
                return False

        for action in self.actions:
            try:
                action()
            except Exception as exc:
                logger.exception("alert '%s' action failed: %s", self.name, exc)

        self._last_fired_monotonic = now
        logger.info("alert '%s' fired", self.name)
        return True


def make_broker_node(node_name: str, params: ConnectionParameters) -> Node:
    """Build a commlib Node for one broker (helper for generated code)."""
    node = Node(node_name=node_name, connection_params=params, heartbeats=False)
    return node


def make_publisher(node: Node, topic: str) -> Callable[[Dict[str, Any]], None]:
    """Return a closure that publishes a dict payload to ``topic``."""
    pub = node.create_publisher(msg_type=None, topic=topic)

    def _publish(payload: Dict[str, Any]) -> None:
        pub.publish(payload)

    return _publish
