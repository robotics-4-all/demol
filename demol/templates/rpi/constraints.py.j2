"""Constraint runtime helper for DeMoL-generated devices.

Generated by demol -- do not edit by hand. Regenerate with:
    demol generate rpi <model>.dev --output-dir <out>

Each declared ``CONSTRAINT`` block in the source model is compiled into a
runtime predicate (lambda) that calls the helper functions below. Predicates
are evaluated on demand by ``check_constraints()``; on a violation the
constraint's MESSAGE is logged via ``logging.warning`` and a monotonic
``constraint_failures`` counter is incremented.

The ``_registry`` is a thread-safe dict populated by ``register_peripheral``
from each peripheral's ``__init__`` so the constraint predicates can read
the live peripheral kind and declared power budget. The ``kind`` token is
the DSL literal (``"SENSOR"`` / ``"ACTUATOR"`` / ``"PERIPHERAL"`` /
``"CONNECTION"``) so the runtime vocabulary mirrors the source model.
"""
import logging
import threading
from typing import Callable, Dict, List, Tuple

logger = logging.getLogger(__name__)


# --- Peripheral registry -----------------------------------------------------

_registry: Dict[str, Dict[str, object]] = {}
_registry_lock = threading.Lock()


def register_peripheral(name: str, kind: str, power_mw: float) -> None:
    """Register a peripheral instance for constraint bookkeeping.

    ``kind`` is the DSL token (``"SENSOR"``, ``"ACTUATOR"``,
    ``"PERIPHERAL"`` or ``"CONNECTION"``); ``power_mw`` is the declared
    ``operational.max`` in milliwatts (use ``None`` when the peripheral
    declares no power budget).
    """
    with _registry_lock:
        _registry[name] = {
            "kind": kind,
            "power_mw": power_mw,
            "connected": True,
        }


# --- Built-in helpers (read from _registry under the lock) -------------------


# Mapping from DSL uppercase keywords (CONSTRAINT grammar) to the
# Python kind strings used by ``register_peripheral``.
_DSL_TO_KIND = {
    "SENSOR": "Sensor",
    "ACTUATOR": "Actuator",
    "PERIPHERAL": "Peripheral",
    "CONNECTION": "Connection",
}


def count(kind: str) -> int:
    """Count peripherals of the given DSL kind in the registry.

    ``kind`` is one of the DSL keywords ``"SENSOR"``, ``"ACTUATOR"``,
    ``"PERIPHERAL"`` or ``"CONNECTION"``. ``"CONNECTION"`` counts
    peripherals currently marked connected; the others count registry
    entries whose ``kind`` field matches the mapped Python kind
    (e.g. ``"Sensor"`` for DSL ``"SENSOR"``).
    """
    with _registry_lock:
        if kind == "CONNECTION":
            return sum(1 for v in _registry.values() if v.get("connected"))
        python_kind = _DSL_TO_KIND.get(kind, kind)
        return sum(1 for v in _registry.values() if v.get("kind") in (kind, python_kind))


def sum_power(kind: str) -> float:
    """Sum of declared ``power_mw`` across peripherals of ``kind`` (in mW)."""
    python_kind = _DSL_TO_KIND.get(kind, kind)
    is_global = kind in ("PERIPHERAL", "CONNECTION")
    with _registry_lock:
        if is_global:
            values = [
                float(v.get("power_mw"))
                for v in _registry.values()
                if v.get("power_mw") is not None
            ]
        else:
            values = [
                float(v.get("power_mw"))
                for v in _registry.values()
                if v.get("kind") in (kind, python_kind) and v.get("power_mw") is not None
            ]
    return sum(values)


def avg_power(kind: str) -> float:
    """Average of declared ``power_mw`` across peripherals of ``kind`` (mW)."""
    python_kind = _DSL_TO_KIND.get(kind, kind)
    is_global = kind in ("PERIPHERAL", "CONNECTION")
    with _registry_lock:
        if is_global:
            values = [
                float(v.get("power_mw"))
                for v in _registry.values()
                if v.get("power_mw") is not None
            ]
        else:
            values = [
                float(v.get("power_mw"))
                for v in _registry.values()
                if v.get("kind") in (kind, python_kind) and v.get("power_mw") is not None
            ]
    if not values:
        return 0.0
    return sum(values) / len(values)


def max_power(kind: str) -> float:
    """Maximum declared ``power_mw`` across peripherals of ``kind`` (mW)."""
    python_kind = _DSL_TO_KIND.get(kind, kind)
    is_global = kind in ("PERIPHERAL", "CONNECTION")
    with _registry_lock:
        if is_global:
            values = [
                float(v.get("power_mw"))
                for v in _registry.values()
                if v.get("power_mw") is not None
            ]
        else:
            values = [
                float(v.get("power_mw"))
                for v in _registry.values()
                if v.get("kind") in (kind, python_kind) and v.get("power_mw") is not None
            ]
    if not values:
        return 0.0
    return max(values)


# --- Compiled constraint predicates ------------------------------------------

_CONSTRAINTS: List[Tuple[str, Callable[[], bool], str]] = [
{% for c in constraints %}
    (
        "{{ c.name }}",
        lambda: ({{ c.predicate }}),
        "{{ c.message }}",
    ),
{% endfor %}
]


# --- Failure counter (read by ALERT integration, future work) ----------------

constraint_failures: int = 0


def check_constraints() -> int:
    """Evaluate every declared constraint. Returns the number of violations.

    Each predicate runs as a zero-argument lambda; property access errors
    (``KeyError``, ``TypeError``, ``ValueError``) are logged and counted as
    a no-fire so a malformed constraint cannot crash the main loop.
    """
    global constraint_failures
    failures_this_pass = 0
    for name, predicate, message in _CONSTRAINTS:
        try:
            ok = bool(predicate())
        except (KeyError, TypeError, ValueError) as exc:
            logger.warning("[Constraint-Eval-Error] %s: %s", name, exc)
            continue
        if not ok:
            constraint_failures += 1
            failures_this_pass += 1
            logger.warning(
                "[Constraint-Violated] %s: %s (failures=%d)",
                name,
                message or "expression is false",
                constraint_failures,
            )
    return failures_this_pass
