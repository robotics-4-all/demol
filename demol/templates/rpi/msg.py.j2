from commlib.msg import MessageHeader, PubSubMessage


class DistanceMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    distance: float = 0.0
    unit: str = "cm"
    max : float = 200.0
    min : float = 0.0


class EnvMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    temperature : float = 25.0
    pressure : float = 1013.25
    humidity : float = 45.00
    gas_resistance : float = 50000.0


class ProximityMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    value : int = 0  # 0: no object, 1: object detected


class ADCMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    voltage: float = 0.0


class LedArrayMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    colors : list = [  # defined in the device
        0xFF0000,  # Red
        0x00FF00,  # Green
        0x0000FF,  # Blue
        0xFFFF00,  # Yellow
        0xFF00FF,  # Magenta
        0x00FFFF,  # Cyan
        0xFFFFFF,  # White
        0x800000,  # Maroon
        0x008000,  # Dark Green
        0x000080,  # Navy
        0xFFA500,  # Orange
        0x800080,  # Purple
    ]
    delay: float = 0.1 
    brightness: float = 0.5


class ServoControllerMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    initial_angle: float = 0.0
    final_angle: float = 0.0
    angular_speed: float = 0.0 # degrees per second
    angular_step: float = 0.0 # degrees


class TemperatureMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    temperature: float = 0.0
    unit: str = "C"


class HumidityMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    humidity: float = 0.0
    unit: str = "%"


class PressureMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    pressure: float = 0.0
    unit: str = "hPa"


class GasMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    gas_resistance: float = 0.0
    unit: str = "Ohm"


class AirQualityMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    aqi: int = 0
    co2: float = 0.0
    tvoc: float = 0.0


class LightMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    lux: float = 0.0


class UVMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    uv_index: float = 0.0


class SoundMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    db: float = 0.0


class DistanceMatrixMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    distances: list = []
    rows: int = 0
    cols: int = 0


class AccelerationMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    x: float = 0.0
    y: float = 0.0
    z: float = 0.0
    unit: str = "m/s^2"


class GyroscopeMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    x: float = 0.0
    y: float = 0.0
    z: float = 0.0
    unit: str = "rad/s"


class MagnetometerMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    x: float = 0.0
    y: float = 0.0
    z: float = 0.0
    unit: str = "uT"


class IMUMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    accel: AccelerationMessage = AccelerationMessage()
    gyro: GyroscopeMessage = GyroscopeMessage()
    mag: MagnetometerMessage = MagnetometerMessage()


class TrackerMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    latitude: float = 0.0
    longitude: float = 0.0
    altitude: float = 0.0


class NeoPixelMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    red: int = 0
    green: int = 0
    blue: int = 0
    index: int = 0


class MotorControllerMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    speed: float = 0.0
    direction: int = 0


class RelayMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
