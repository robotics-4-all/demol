class SwitchMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    state: bool = False


class ButtonMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    state: bool = False


class LedMessage(PubSubMessage):
    header: MessageHeader = MessageHeader()
    state: bool = False
    brightness: float = 1.0


class BuzzerMessage(PubSubMessage):
