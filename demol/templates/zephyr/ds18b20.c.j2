/*
 * Zephyr DS18B20 driver (1-Wire temperature sensor).
 * Generated by demol — custom 1-Wire bit-bang driver over a single GPIO
 * (Zephyr ships no DS18B20 driver). Expects a node with compatible =
 * "demol,ds18b20" and a "data-gpios" phandle-array property.
 */

#include <zephyr/device.h>
#include <zephyr/drivers/gpio.h>
#include <zephyr/kernel.h>

#include "{{ name }}.h"

#define DS18B20_CMD_SKIP_ROM      0xCC
#define DS18B20_CMD_CONVERT_T     0x44
#define DS18B20_CMD_READ_SCRATCH  0xBE
#define DS18B20_FAMILY_CODE       0x28

static const struct gpio_dt_spec ds18b20_data =
	GPIO_DT_SPEC_GET(DT_INST(0, demol_ds18b20), data_gpios);

/*·CRC-8/Maxim (poly 0x31, init 0x00) over the 9 scratchpad bytes. */
static uint8_t ds18b20_crc8(const uint8_t *buf, size_t len)
{
	uint8_t crc = 0;

	for (size_t i = 0; i < len; i++) {
		uint8_t b = buf[i];

		for (int bit = 0; bit < 8; bit++) {
			bool mix = (crc ^ b) & 0x01;
			crc >>= 1;
			if (mix) {
				crc ^= 0x8C;
			}
			b >>= 1;
		}
	}
	return crc;
}

/*·Issue a reset pulse; return 0 when a device pulls presence, -ENODEV
 * otherwise.
 */
static int ds18b20_reset(void)
{
	gpio_pin_configure_dt(&ds18b20_data, GPIO_OUTPUT);
	gpio_pin_set_dt(&ds18b20_data, 0);
	k_busy_wait(480);
	gpio_pin_configure_dt(&ds18b20_data, GPIO_INPUT);
	k_busy_wait(70);
	int present = !gpio_pin_get_dt(&ds18b20_data);
	k_busy_wait(410);
	return present ? 0 : -ENODEV;
}

static void ds18b20_write_bit(bool one)
{
	gpio_pin_configure_dt(&ds18b20_data, GPIO_OUTPUT);
	gpio_pin_set_dt(&ds18b20_data, 0);
	if (one) {
		k_busy_wait(6);
		gpio_pin_set_dt(&ds18b20_data, 1);
		k_busy_wait(64);
	} else {
		k_busy_wait(60);
		gpio_pin_set_dt(&ds18b20_data, 1);
		k_busy_wait(10);
	}
}

static bool ds18b20_read_bit(void)
{
	bool val;

	gpio_pin_configure_dt(&ds18b20_data, GPIO_OUTPUT);
	gpio_pin_set_dt(&ds18b20_data, 0);
	k_busy_wait(6);
	gpio_pin_configure_dt(&ds18b20_data, GPIO_INPUT);
	k_busy_wait(9);
	val = gpio_pin_get_dt(&ds18b20_data);
	k_busy_wait(55);
	return val;
}

static void ds18b20_write_byte(uint8_t b)
{
	for (int i = 0; i < 8; i++) {
		ds18b20_write_bit(b & 0x01);
		b >>= 1;
	}
}

static uint8_t ds18b20_read_byte(void)
{
	uint8_t b = 0;

	for (int i = 0; i < 8; i++) {
		if (ds18b20_read_bit()) {
			b |= (uint8_t)(1U << i);
		}
	}
	return b;
}

int ds18b20_init(void)
{
	if (!device_is_ready(ds18b20_data.port)) {
		return -ENODEV;
	}
	gpio_pin_configure_dt(&ds18b20_data, GPIO_OUTPUT_HIGH);
	return ds18b20_reset();
}

int ds18b20_read(struct ds18b20_data *data)
{
	uint8_t scratch[9];
	int16_t raw;

	if (!data) {
		return -EINVAL;
	}

	/* Start temperature conversion on all devices (SKIP ROM). */
	if (ds18b20_reset() < 0) {
		return -ENODEV;
	}
	ds18b20_write_byte(DS18B20_CMD_SKIP_ROM);
	ds18b20_write_byte(DS18B20_CMD_CONVERT_T);
	k_msleep(750);

	/* Read the 9-byte scratchpad. */
	if (ds18b20_reset() < 0) {
		return -ENODEV;
	}
	ds18b20_write_byte(DS18B20_CMD_SKIP_ROM);
	ds18b20_write_byte(DS18B20_CMD_READ_SCRATCH);
	for (int i = 0; i < 9; i++) {
		scratch[i] = ds18b20_read_byte();
	}

	if (scratch[0] == 0x00 && scratch[1] == 0x00) {
		return -EIO;
	}
	if (ds18b20_crc8(scratch, 8) != scratch[8]) {
		return -EIO;
	}

	/* 12-bit result, 0.0625 degC per LSB, two's complement. */
	raw = (int16_t)(((uint16_t)scratch[1] << 8) | scratch[0]);
	data->temperature = raw / 16.0;
	return 0;
}
