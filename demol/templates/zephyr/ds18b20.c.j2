/*
 * Zephyr DS18B20 driver (1-Wire temperature sensor).
 * Generated by demol — uses Zephyr's built-in maxim,ds18b20 sensor
 * driver via the unified sensor_sample_fetch / sensor_channel_get API.
 */

#include <zephyr/device.h>
#include <zephyr/drivers/sensor.h>

#include "{{ name }}.h"

static const struct device *ds18b20_dev = DEVICE_DT_GET(DT_INST(0, maxim_ds18b20));

int ds18b20_init(void)
{
    if (!device_is_ready(ds18b20_dev)) {
        return -ENODEV;
    }
    return 0;
}

int ds18b20_read(struct ds18b20_data *data)
{
    struct sensor_value t = {0};

    if (sensor_sample_fetch(ds18b20_dev) < 0) {
        return -EIO;
    }

    sensor_channel_get(ds18b20_dev, SENSOR_CHAN_AMBIENT_TEMP, &t);

    data->temperature = sensor_value_to_double(&t);
    return 0;
}
