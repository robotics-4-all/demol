/*
 * Zephyr CONSTRAINT runtime — public API.
 * Generated by demol for {{ device_name }}.
 *
 * Each declared CONSTRAINT becomes a predicate function that the periodic
 * k_work_delayable callback invokes via check_constraints(). The state mutex
 * is exposed so peripheral drivers can register themselves safely from any
 * Zephyr thread context.
 */
#ifndef DEMOL_CONSTRAINT_H_
#define DEMOL_CONSTRAINT_H_

#include <zephyr/kernel.h>

#ifdef __cplusplus
extern "C" {
#endif

/* Maximum number of peripherals tracked by the constraint runtime. Mirrors
 * the design doc §4.1 value and is shared with constraint.c. */
#ifndef DEMOL_MAX_PERIPHERALS
#define DEMOL_MAX_PERIPHERALS 16
#endif

/* Peripheral kind codes used by the constraint runtime. Values match the
 * built-in function table in docs/constraint-runtime-design.md §4.1. */
#define DEMOL_KIND_SENSOR     0
#define DEMOL_KIND_ACTUATOR   1
#define DEMOL_KIND_PERIPHERAL 2

/* Per-peripheral runtime state. Drivers call register_peripheral() to fill
 * their slot; the constraint predicates then read these fields under
 * constraint_mutex. */
struct periph_state {
	const char *name;
	uint8_t kind;
	int32_t power_mW;     /* -1 if unknown / not measured */
	bool connected;
};

/* Process-wide mutex protecting _devices[]. Drivers acquire it inside
 * register_peripheral() so the table stays consistent under concurrent
 * registration. */
extern struct k_mutex constraint_mutex;

/* Process-wide counter of constraint failures. Read by check_constraints()
 * on each tick, and exposed for the ALERT subsystem to query. */
extern atomic_t constraint_failures;

/* Register a peripheral with the constraint runtime. Must be called once
 * per peripheral during its init path. power_mW == -1 means "unknown". */
void register_peripheral(const char *name, uint8_t kind, int32_t power_mW);

/* Initialise the constraint runtime. Call from main() before k_sleep().
 * Schedules the periodic check work item. */
void constraint_init(void);

/* Evaluate every declared CONSTRAINT and log/inc on failure. Safe to call
 * from any thread; acquires constraint_mutex briefly per predicate. */
void check_constraints(void);

{% for c in constraints %}
/* Predicate for CONSTRAINT {{ c.name }}. */
bool {{ c.predicate_func }}(void);
{% endfor %}

#ifdef __cplusplus
}
#endif

#endif /* DEMOL_CONSTRAINT_H_ */
