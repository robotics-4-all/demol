#include <zephyr/device.h>
#include <zephyr/drivers/gpio.h>

#include "{{ name }}.h"

static const struct gpio_dt_spec relay = GPIO_DT_SPEC_GET(DT_INST(0, demol_relay), gpios);

int relay_init(void)
{
    if (!gpio_is_ready_dt(&relay)) {
        return -ENODEV;
    }
    return gpio_pin_configure_dt(&relay, GPIO_OUTPUT);
}

