/*
 * Zephyr MPL3115A2 driver (env sensor: temperature, pressure).
 * Generated by demol — uses Zephyr's built-in nxp,mpl3115a2 sensor
 * driver via the unified sensor_sample_fetch / sensor_channel_get API.
 */

#include <zephyr/device.h>
#include <zephyr/drivers/sensor.h>

#include "{{ name }}.h"

static const struct device *mpl3115a2_dev = DEVICE_DT_GET(DT_INST(0, nxp_mpl3115a2));

int mpl3115a2_init(void)
{
    if (!device_is_ready(mpl3115a2_dev)) {
        return -ENODEV;
    }
    return 0;
}

int mpl3115a2_read(struct mpl3115a2_data *data)
{
    struct sensor_value t = {0};
    struct sensor_value p = {0};

    if (sensor_sample_fetch(mpl3115a2_dev) < 0) {
        return -EIO;
    }

    sensor_channel_get(mpl3115a2_dev, SENSOR_CHAN_AMBIENT_TEMP, &t);
    sensor_channel_get(mpl3115a2_dev, SENSOR_CHAN_PRESS, &p);

    data->temperature = sensor_value_to_double(&t);
    data->pressure    = sensor_value_to_double(&p);
    return 0;
}
