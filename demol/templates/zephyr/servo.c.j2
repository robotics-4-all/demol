/*
 * Zephyr Servo driver (PWM 50Hz, 1-2ms pulse width).
 * Generated by demol — uses pwm_dt_spec.
 */

#include <zephyr/device.h>
#include <zephyr/drivers/pwm.h>

#include "{{ name }}.h"

static const struct pwm_dt_spec servo = PWM_DT_SPEC_GET(DT_INST(0, demol_servo));

#define SERVO_PERIOD_USEC 20000U   /* 20ms = 50Hz */
#define SERVO_MIN_USEC    1000U    /* -90 deg */
#define SERVO_MAX_USEC    2000U    /* +90 deg */
#define SERVO_MID_USEC    1500U    /* 0 deg */

int servo_init(void)
{
    if (!pwm_is_ready_dt(&servo)) {
        return -ENODEV;
    }
    return servo_set_usec(SERVO_MID_USEC);
}

int servo_set_angle(int angle)
{
    if (angle < -90) angle = -90;
    if (angle > 90) angle = 90;
    /* Map -90..+90 to SERVO_MIN..SERVO_MAX */
    uint32_t pulse = SERVO_MIN_USEC +
        ((uint32_t)(angle + 90) * (SERVO_MAX_USEC - SERVO_MIN_USEC)) / 180U;
    return pwm_set_usec_dt(&servo, servo.period, pulse);
}
