cmake_minimum_required(VERSION 3.20.0)
find_package(Zephyr REQUIRED HINTS $ENV{ZEPHYR_BASE})
project({{ board_name }})
target_sources(app PRIVATE src/main.c{% for s in sources %}{% if s != "main" %} src/{{ s }}.c{% endif %}{% endfor %}{% if has_constraints %} src/constraint.c{% endif %})
target_include_directories(app PRIVATE src/include)
