/*
 * Zephyr SRF05 driver (trigger-echo ultrasonic distance sensor).
 * Generated by demol — uses the shared trigger_echo_init /
 * trigger_echo_read macros from _macros.j2.
 *
 * Note: SRF05 is timing-compatible with SRF04; the same trigger-then-
 * measure-echo protocol applies.
 */

#include <zephyr/device.h>
#include <zephyr/drivers/gpio.h>

#include "{{ name }}.h"

{% import "_macros.j2" as macros %}
{{ macros.trigger_echo_init(trig, echo) }}
{{ macros.trigger_echo_read(trig, echo, timeout_us) }}

static const struct gpio_dt_spec srf05_trigger = GPIO_DT_SPEC_GET(DT_INST(0, gpio_trigger), gpios);
static const struct gpio_dt_spec srf05_echo    = GPIO_DT_SPEC_GET(DT_INST(0, gpio_echo),    gpios);
static const struct device *srf05_dev          = DEVICE_DT_GET(DT_INST(0, gpio_trigger));

int srf05_init(void)
{
    return trigger_echo_init_{{ trig }}_{{ echo }}(srf05_dev);
}

int srf05_read_cm(uint32_t timeout_us)
{
    ARG_UNUSED(srf05_trigger);
    ARG_UNUSED(srf05_echo);
    return trigger_echo_read_{{ trig }}_{{ echo }}(srf05_dev, timeout_us);
}
