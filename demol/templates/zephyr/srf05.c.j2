/*
 * Zephyr SRF05 driver (trigger-echo ultrasonic distance sensor).
 * Generated by demol — direct GPIO bit-bang driver. Expects a node
 * with compatible = "demol,srf05" and trigger/echo gpios properties.
 */

#include <zephyr/device.h>
#include <zephyr/drivers/gpio.h>
#include <zephyr/kernel.h>

#include "{{ name }}.h"

static const struct gpio_dt_spec srf05_trigger =
	GPIO_DT_SPEC_GET(DT_INST(0, demol_srf05), trigger_gpios);
static const struct gpio_dt_spec srf05_echo =
	GPIO_DT_SPEC_GET(DT_INST(0, demol_srf05), echo_gpios);

int srf05_init(void)
{
	if (!device_is_ready(srf05_trigger.port) ||
	    !device_is_ready(srf05_echo.port)) {
		return -ENODEV;
	}
	gpio_pin_configure_dt(&srf05_trigger, GPIO_OUTPUT_INACTIVE);
	return gpio_pin_configure_dt(&srf05_echo, GPIO_INPUT);
}

/* Speed of sound ~343 m/s: 1 cm round-trip takes ~58 us. */
#define SRF05_US_PER_CM 58U

int srf05_read_cm(uint32_t timeout_us)
{
	uint32_t width = 0;

	/* 10 us trigger pulse. */
	gpio_pin_set_dt(&srf05_trigger, 1);
	k_busy_wait(10);
	gpio_pin_set_dt(&srf05_trigger, 0);

	/* Wait for the echo line to rise. */
	while (!gpio_pin_get_dt(&srf05_echo)) {
		if (++width > timeout_us) {
			return -ETIMEDOUT;
		}
		k_busy_wait(1);
	}

	/* Measure the echo pulse width. */
	width = 0;
	while (gpio_pin_get_dt(&srf05_echo)) {
		if (++width > timeout_us) {
			return -ETIMEDOUT;
		}
		k_busy_wait(1);
	}

	return (int)(width / SRF05_US_PER_CM);
}
