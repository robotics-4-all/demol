{#-
  Zephyr application entry point.

  Renders one of two branches based on whether the model declares SAMPLING
  blocks:
    * {% if samplings %} emits a deterministic `while (1) { k_msleep(...);
      read_<peripheral>(); }` main loop. Each sampling entry has keys:
        - peripheral:   lowercased base name (matches the .c driver file)
        - rate:         integer Hz requested by the DSL
        - mode:         one of continuous|on_change|batch|on_demand
        - period_ms:    1000 // rate, the k_msleep divisor
        - buffer_size:  integer buffer length (only meaningful in batch mode)
      A single k_msleep(<min_period_ms>) runs at the top of the loop, so the
      fastest sampling drives the cadence and slower samplings are simply
      over-sampled.  This is the conservative choice — under-sampling would
      violate the contract; over-sampling only wastes a few CPU cycles.
    * {% else %} preserves the static skeleton byte-identically so existing
      golden snapshots for non-SAMPLING examples stay stable (backward
      compat — see AGENTS.md: all new codegen is guarded by `if model.X`).
-#}
{% if samplings -%}
{% for s in samplings -%}
#include "{{ s.peripheral }}.h"
{% endfor -%}
/*
 * Zephyr application entry point.
 * Generated by demol — SAMPLING loop.
 */

#include <zephyr/kernel.h>
{% for s in samplings -%}
{% if s.mode == 'on_change' %}
static struct {{ s.peripheral }}_data last_{{ s.peripheral }};
{% elif s.mode == 'batch' %}
static struct {{ s.peripheral }}_data buf_{{ s.peripheral }}[{{ s.buffer_size }}];
static int buf_{{ s.peripheral }}_count;
{% elif s.mode == 'on_demand' %}
/* {{ s.peripheral }}: on_demand — no polling. Reserved RPC handler stub. */
static int rpc_handler_{{ s.peripheral }}(void);
{% endif -%}
{% endfor %}

int main(void)
{
        while (1) {
                k_msleep({{ min_period_ms }});
{% for s in samplings -%}
{% if s.mode == 'continuous' %}
                {{ s.peripheral }}_read();
{% elif s.mode == 'on_change' %}
                {
                        struct {{ s.peripheral }}_data current;
                        if ({{ s.peripheral }}_read(&current) == 0) {
                                if (current.temperature != last_{{ s.peripheral }}.temperature) {
                                        last_{{ s.peripheral }} = current;
                                }
                        }
                }
{% elif s.mode == 'batch' %}
                {{ s.peripheral }}_read(&buf_{{ s.peripheral }}[buf_{{ s.peripheral }}_count % {{ s.buffer_size }}]);
                buf_{{ s.peripheral }}_count++;
{% elif s.mode == 'on_demand' %}
                /* on_demand: handled via rpc_handler_{{ s.peripheral }}() */
{% endif -%}
{% endfor %}
        }
        return 0;
}
{%- else -%}
/*
 * Zephyr application entry point.
 * Generated by demol — driver logic is added in a later task.
 */

#include <zephyr/kernel.h>

int main(void)
{
        return 0;
}
{%- endif %}
