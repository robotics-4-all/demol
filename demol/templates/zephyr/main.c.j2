{#-
  Zephyr application entry point.

  Active branch (alerts or samplings):
    * ALERTs (T15) take priority over SAMPLINGs (T14).  For every ALERT the
      template emits:
        - a `static int64_t last_trigger_<name>_ms = 0;` cooldown gate
        - one `if (cond) { ... }` block per alert inside `void check_alerts(void)`
        - a `LOG_INF` placeholder for PUBLISH actions (full MQTT publish
          is owned by T16)
        - a `gpio_pin_set_dt(NULL, 1)` placeholder for ACTIVATE actions
    * When SAMPLINGs exist, the template emits the existing per-peripheral
      read loop (`while (1) { k_msleep(period); read_<peripheral>(); }`)
      and calls `check_alerts()` at the bottom of each iteration so the
      alert evaluator sees the freshly read sample buffer.
    * When only ALERTs exist, the template emits a pure check loop
      (`while (1) { check_alerts(); k_msleep(1000); }`).

  Static branch (else):
    * The pre-T14 static `_APP_SRC_MAIN_C` skeleton, byte-identical for
      backward compat (no SAMPLING, no ALERT, no MQTT).
-#}
{% if alerts or samplings -%}
{% if alerts %}
#include "{{ alerts[0].peripheral }}.h"
{% if alerts|map(attribute='action')|select('equalto', 'activate')|list %}
#include <zephyr/drivers/gpio.h>
{% endif %}
#include <zephyr/logging/log.h>
{% endif %}
/*
 * Zephyr application entry point.
 * Generated by demol{% if alerts %} -- ALERT trigger loop{% elif samplings %} -- SAMPLING loop{% endif %}.
 */

#include <zephyr/kernel.h>
{% if alerts %}
LOG_MODULE_REGISTER(app, LOG_LEVEL_INF);

static struct {{ alerts[0].peripheral }}_data {{ alerts[0].peripheral }}_data = {0};
{% for a in alerts %}
static int64_t last_trigger_{{ a.name }}_ms = 0;
{% endfor %}

void check_alerts(void)
{
	int64_t now_ms = k_uptime_get();
{% for a in alerts %}
	/* ALERT {{ a.name }} on {{ a.peripheral }} -- {{ a.action }} "{{ a.topic }}" */
	if ({{ a.condition_c }}) {
		if (last_trigger_{{ a.name }}_ms == 0 ||
		    (now_ms - last_trigger_{{ a.name }}_ms) >= {{ a.cooldown_ms }}) {
			last_trigger_{{ a.name }}_ms = now_ms;
{% if a.action == "publish" %}
			LOG_INF("ALERT {{ a.name }}: PUBLISH to {{ a.topic }}");
{% elif a.action == "activate" %}
			/* T15 placeholder: full ACTIVATE wiring is owned by T16. */
			gpio_pin_set_dt(NULL, 1);
{% endif %}
		}
	}
{% endfor %}
}

{% endif %}
{% if samplings %}
{% for s in samplings -%}
{% if s.mode in ('continuous', 'on_change', 'batch') %}
#include "{{ s.peripheral }}.h"
{% endif -%}
{% endfor %}
{% for s in samplings -%}
{% if s.mode == 'on_change' %}
static struct {{ s.peripheral }}_data last_{{ s.peripheral }};
{% elif s.mode == 'batch' %}
static struct {{ s.peripheral }}_data buf_{{ s.peripheral }}[{{ s.buffer_size }}];
static int buf_{{ s.peripheral }}_count;
{% elif s.mode == 'on_demand' %}
/* {{ s.peripheral }}: on_demand -- no polling. Reserved RPC handler stub. */
static int rpc_handler_{{ s.peripheral }}(void);
{% endif -%}
{% endfor %}

{% endif %}
int main(void)
{
{% if samplings %}
	while (1) {
		k_msleep({{ min_period_ms }});
{% for s in samplings -%}
{% if s.mode == 'continuous' %}
		{{ s.peripheral }}_read();
{% elif s.mode == 'on_change' %}
		{
			struct {{ s.peripheral }}_data current;
			if ({{ s.peripheral }}_read(&current) == 0) {
				if (current.temperature != last_{{ s.peripheral }}.temperature) {
					last_{{ s.peripheral }} = current;
				}
			}
		}
{% elif s.mode == 'batch' %}
		{{ s.peripheral }}_read(&buf_{{ s.peripheral }}[buf_{{ s.peripheral }}_count % {{ s.buffer_size }}]);
		buf_{{ s.peripheral }}_count++;
{% elif s.mode == 'on_demand' %}
		/* on_demand: handled via rpc_handler_{{ s.peripheral }}() */
{% endif -%}
{% endfor %}
{% if alerts %}
		check_alerts();
{% endif %}
	}
{% else %}
{% if alerts %}
	while (1) {
		check_alerts();
		k_msleep({{ min_period_ms }});
	}
{% else %}
	(void)0;
{% endif %}
{% endif %}
	return 0;
}
{%- else -%}
/*
 * Zephyr application entry point.
 * Generated by demol -- driver logic is added in a later task.
 */

#include <zephyr/kernel.h>

int main(void)
{
	return 0;
}
{%- endif %}
