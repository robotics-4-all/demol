#!/bin/bash

# Colors for terminal
GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Build script for RiotOS using Docker
# Generated by DeMoL

BOARD="{{ board_name }}"
IMAGE="riot/riotbuild:latest"
APP_DIR=$(pwd)

# Detect RIOTBASE
if [ -z "$RIOTBASE" ]; then
    # Check common locations relative to where the script is run
    if [ -d "../../RIOT" ]; then
        RIOTBASE=$(realpath "../../RIOT")
    elif [ -d "$HOME/RIOT" ]; then
        RIOTBASE="$HOME/RIOT"
    fi
fi

echo -e "${BLUE}================================================================================${NC}"
echo -e "${BLUE}DeMoL RiotOS Docker Build Script${NC}"
echo -e "${BLUE}================================================================================${NC}"
echo -e "Board:          ${YELLOW}$BOARD${NC}"
echo -e "RIOTBASE:       ${YELLOW}${RIOTBASE:-"Not Set"}${NC}"
echo -e "Docker Image:   ${YELLOW}$IMAGE${NC}"
echo -e "App Directory:  ${YELLOW}$APP_DIR${NC}"
echo -e "${BLUE}================================================================================${NC}"

# Check RIOTBASE
if [ -z "$RIOTBASE" ] || [ ! -d "$RIOTBASE" ]; then
    echo -e "${RED}[ERROR] RIOTBASE directory '$RIOTBASE' not found.${NC}"
    echo -e "        Please set RIOTBASE environment variable to your RIOT source directory."
    echo -e "        Example: export RIOTBASE=/path/to/RIOT"
    exit 1
fi

# Check Docker
if ! command -v docker &> /dev/null; then
    echo -e "${RED}[ERROR] Docker is not installed or not in PATH.${NC}"
    exit 1
fi

# Check if image exists, pull if not
if [[ "$(docker images -q $IMAGE 2> /dev/null)" == "" ]]; then
    echo -e "${BLUE}[INFO] Pulling Docker image $IMAGE...${NC}"
    docker pull $IMAGE
fi

echo -e "${BLUE}[*] Preparing Docker command...${NC}"

# We mount the current app directory to /data/app
DOCKER_CMD="docker run --rm -v $APP_DIR:/data/app -w /data/app"
MAKE_ARGS="BOARD=$BOARD"

# Handle RIOTBASE mounting
RIOTBASE_ABS=$(realpath "$RIOTBASE")
# Mount RIOTBASE to /riot
DOCKER_CMD="$DOCKER_CMD -v $RIOTBASE_ABS:/riot"
# Use anonymous volume for esptools venv to avoid path mismatch
DOCKER_CMD="$DOCKER_CMD -v /riot/dist/tools/esptools/venv"
MAKE_ARGS="$MAKE_ARGS RIOTBASE=/riot"

echo -e "${BLUE}[*] Running build in Docker...${NC}"
echo -e "${YELLOW}--------------------------------------------------------------------------------${NC}"

# Run make with venv initialization
$DOCKER_CMD $IMAGE /bin/bash -c "python3 -m venv /riot/dist/tools/esptools/venv && make $MAKE_ARGS"

BUILD_RET=$?

echo -e "${YELLOW}--------------------------------------------------------------------------------${NC}"
if [ $BUILD_RET -eq 0 ]; then
    echo -e "${GREEN}[SUCCESS] Build completed successfully!${NC}"
    if [ -d "bin/$BOARD" ]; then
        echo -e "${BLUE}[INFO] Artifacts location: bin/$BOARD/${NC}"
    fi
else
    echo -e "${RED}[ERROR] Build failed with exit code $BUILD_RET${NC}"
    exit $BUILD_RET
fi
