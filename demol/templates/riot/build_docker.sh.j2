#!/bin/bash
#
# Self-contained DeMoL RIOT build script.
# Generated by DeMoL — do not edit by hand.
#
# Usage:  ./build_docker.sh
#
# Requirements: Docker. No other prerequisites — this script will build
# (or pull) a tagged "demol/riotbuild" image with RIOT pre-cloned the
# first time it runs, then reuse the cached image on subsequent runs.

set -euo pipefail

# --- Configuration ----------------------------------------------------------
BOARD="${BOARD:-{{ board_name }}}"
RIOT_VERSION="${RIOT_VERSION:-{{ riot_version | default('2025.10') }}}"
IMAGE_TAG="${IMAGE_TAG:-demol/riotbuild:${RIOT_VERSION}}"
APP_DIR="$(cd "$(dirname "$0")" && pwd)"
DOCKERFILE="${APP_DIR}/Dockerfile.riotbuild"

# --- Colors -----------------------------------------------------------------
GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${BLUE}================================================================================${NC}"
echo -e "${BLUE}DeMoL RIOT Docker Build${NC}"
echo -e "${BLUE}================================================================================${NC}"
echo -e "Board:          ${YELLOW}${BOARD}${NC}"
echo -e "RIOT version:   ${YELLOW}${RIOT_VERSION}${NC}"
echo -e "Builder image:  ${YELLOW}${IMAGE_TAG}${NC}"
echo -e "App directory:  ${YELLOW}${APP_DIR}${NC}"
echo -e "${BLUE}================================================================================${NC}"

# --- Pre-flight: Docker available -------------------------------------------
if ! command -v docker >/dev/null 2>&1; then
    echo -e "${RED}[ERROR] Docker is not installed or not in PATH.${NC}"
    exit 1
fi

# --- Build the demol/riotbuild image if missing -----------------------------
if [[ -z "$(docker images -q "${IMAGE_TAG}" 2>/dev/null)" ]]; then
    if [[ ! -f "${DOCKERFILE}" ]]; then
        echo -e "${RED}[ERROR] Dockerfile.riotbuild not found at ${DOCKERFILE}${NC}"
        echo -e "        Re-run 'demol generate riot ...' to regenerate the build environment."
        exit 1
    fi
    echo -e "${BLUE}[INFO] Builder image not found locally. Building ${IMAGE_TAG}...${NC}"
    echo -e "${YELLOW}        (first-time build clones RIOT — may take several minutes)${NC}"
    docker build \
        --build-arg "RIOT_VERSION=${RIOT_VERSION}" \
        -t "${IMAGE_TAG}" \
        -f "${DOCKERFILE}" \
        "${APP_DIR}"
    echo -e "${GREEN}[OK] Builder image cached as ${IMAGE_TAG}${NC}"
else
    echo -e "${BLUE}[INFO] Using cached builder image ${IMAGE_TAG}${NC}"
fi

# --- Compile the application ------------------------------------------------
echo -e "${BLUE}[*] Compiling application...${NC}"
echo -e "${YELLOW}--------------------------------------------------------------------------------${NC}"

set +e
docker run --rm \
    -v "${APP_DIR}:/data/app" \
    -v "/riot/dist/tools/esptools/venv" \
    -w /data/app \
    "${IMAGE_TAG}" \
    /bin/bash -c "python3 -m venv /riot/dist/tools/esptools/venv >/dev/null 2>&1 || true; make BOARD=${BOARD} RIOTBASE=/riot"
BUILD_RET=$?
set -e

echo -e "${YELLOW}--------------------------------------------------------------------------------${NC}"
if [[ ${BUILD_RET} -eq 0 ]]; then
    echo -e "${GREEN}[SUCCESS] Build completed successfully.${NC}"
    if [[ -d "${APP_DIR}/bin/${BOARD}" ]]; then
        echo -e "${BLUE}[INFO] Artifacts location: ${APP_DIR}/bin/${BOARD}/${NC}"
    fi
else
    echo -e "${RED}[ERROR] Build failed with exit code ${BUILD_RET}.${NC}"
    exit "${BUILD_RET}"
fi
