#!/bin/bash

# Build script for RiotOS using Docker
# Generated by DeMoL

BOARD="{{ board_name }}"
RIOTBASE=${RIOTBASE:-$HOME/RIOT}
IMAGE="riot/riotbuild:latest"

echo "================================================================================"
echo "DeMoL RiotOS Docker Build Script"
echo "================================================================================"
echo "Board:          $BOARD"
echo "RIOTBASE:       $RIOTBASE"
echo "Docker Image:   $IMAGE"
echo "Current Dir:    $(pwd)"
echo "================================================================================"

# Check RIOTBASE
if [ ! -d "$RIOTBASE" ]; then
    echo "[ERROR] RIOTBASE directory '$RIOTBASE' not found."
    echo "        Please set RIOTBASE environment variable to your RIOT source directory."
    echo "        Example: export RIOTBASE=/path/to/RIOT"
    exit 1
fi

# Check Docker
if ! command -v docker &> /dev/null; then
    echo "[ERROR] Docker is not installed or not in PATH."
    exit 1
fi

# Check if image exists, pull if not
if [[ "$(docker images -q $IMAGE 2> /dev/null)" == "" ]]; then
    echo "[INFO] Pulling Docker image $IMAGE..."
    docker pull $IMAGE
fi

echo "[INFO] Starting build process..."
echo "--------------------------------------------------------------------------------"

# Run some info commands first for "excessive information"
docker run --rm \
    -v "$RIOTBASE":/riot \
    -v "$(pwd)":/app \
    -w /app \
    -e RIOTBASE=/riot \
    "$IMAGE" \
    /bin/bash -c "echo 'Compiler version:'; arm-none-eabi-gcc --version | head -n 1; echo 'Make version:'; make --version | head -n 1; echo 'RIOT version:'; make -C /riot info-boards-supported | grep -q $BOARD && echo 'Board supported by RIOT source'"

# Run make with V=1 for excessive information
docker run --rm \
    -v "$RIOTBASE":/riot \
    -v "$(pwd)":/app \
    -w /app \
    -e RIOTBASE=/riot \
    "$IMAGE" \
    make BOARD="$BOARD" V=1

BUILD_RET=$?

echo "--------------------------------------------------------------------------------"
if [ $BUILD_RET -eq 0 ]; then
    echo "[SUCCESS] Build completed successfully!"
    if [ -d "bin/$BOARD" ]; then
        echo "[INFO] Artifacts location: bin/$BOARD/"
        echo "[INFO] Generated files:"
        ls -R bin/$BOARD/
    fi
else
    echo "[ERROR] Build failed with exit code $BUILD_RET"
    exit $BUILD_RET
fi
