#include "json_handler.h"

#include <string.h>
#include <stdint.h>
#include <stdio.h>
#include <stdarg.h>
#include <string.h>


int key_exists(json_loader_t *loader, const char *key);
int get_keys_int_value(json_loader_t *loader, int *val);
int get_keys_string_value(json_loader_t *loader, char *str);


int json_init(json_loader_t *loader, char *json_string, int json_length) {
    jsmn_init(&loader->parser);
    
    loader->num_of_tokens = jsmn_parse(&loader->parser, 
                            json_string, 
                            json_length, 
                            loader->token, MAX_TOKEN_NUM);
                            
    loader->search_index = 1; 
    loader->json_string = json_string;

    if (loader->num_of_tokens >= 0) {
        if (loader->token[0].type == JSMN_OBJECT) {      
            return 0;      
        } else {
            return -1;
        }
    } else {
        return -2;
    }
}

int json_load(json_loader_t *loader, ...) {
    va_list list;    
    va_start(list, loader);

    json_type_t json_type = va_arg(list, int);

    while (json_type == JSON_KEY) {
        char *key = va_arg(list, char*);
        int ret = key_exists(loader, key);
        
        if (ret == 0) {
            if (loader->token[loader->search_index].type == JSMN_PRIMITIVE) {
                get_keys_int_value(loader, va_arg(list, int*));
            } else {
                get_keys_string_value(loader, va_arg(list, char*));
            }
        }
        
        json_type = va_arg(list, int);
    }

    va_end(list);

    return 0;
}

int json_dumps(char *json_str, ...) {
    int index = 0;
    int depth = 0;

    memset(json_str, '\0', strlen(json_str));

    va_list list;    
    va_start(list, json_str);

    json_type_t json_type = va_arg(list, int);

    while (depth > 0 || index == 0) {
        if (json_type == JSON_START) {
            json_str[index++] = '{';
            depth = depth + 1;
        } else if (json_type == JSON_STOP) {
            if (json_str[index-1] == ',') {
                json_str[index-1] = '}';
                if (depth > 1) {
                    json_str[index++] = ',';
                }
            } else {
                json_str[index++] = '}';
            }
            depth = depth - 1;
        } else if (json_type == JSON_KEY) {
            char *key = va_arg(list, char*);

            json_str[index++] = '\"';
            memcpy(&json_str[index], key, strlen(key));
            index = index + strlen(key);
            json_str[index++] = '\"';
            json_str[index++] = ':';
        } else if (json_type == JSON_INT) {
            char int_num[20];

            sprintf(int_num,"%d", va_arg(list, int));
            memcpy(&json_str[index], int_num, strlen(int_num));
            index = index + strlen(int_num);
            json_str[index++] = ',';
        } else if (json_type == JSON_STR) {
            char *str = va_arg(list, char*);

            json_str[index++] = '\"';
            memcpy(&json_str[index], str, strlen(str));
            index = index + strlen(str);
            json_str[index++] = '\"';
            json_str[index++] = ',';
        } else if (json_type == JSON_OBJECT) {
            char *str = va_arg(list, char*);

            memcpy(&json_str[index], str, strlen(str));
            index = index + strlen(str);
            json_str[index++] = ',';
        } 

        json_type = va_arg(list, int);
    }

    va_end(list);

    json_str[index] = '\0';

    return 0;
}

int key_exists(json_loader_t *loader, const char *key) {
    for (int i = (loader->search_index); i < (loader->num_of_tokens); i++ ) {
        uint16_t key_length = (loader->token[i].end - loader->token[i].start);

        if (loader->token[i].type == JSMN_STRING && strlen(key) == key_length) {
            if (strncmp(loader->json_string + loader->token[i].start, key, key_length) == 0) {
                
                if ((i + 1) < loader->num_of_tokens) {
                    loader->search_index = i + 1;
                } else {
                    loader->search_index = i;
                }

                return 0;
            }
        }
    }

    return -1;
}

int get_keys_int_value(json_loader_t *loader, int *val) {
    if ((loader->search_index) > 0 && loader->token[(loader->search_index)].type == JSMN_PRIMITIVE) {
        char temp[15] = "";

        int size = loader->token[(loader->search_index)].end - loader->token[(loader->search_index)].start;

        strncpy(temp, loader->json_string + loader->token[(loader->search_index)].start, size);
        sscanf(temp, "%d", val);

        return 0;
    }

    return -1;
}

int get_keys_string_value(json_loader_t *loader, char *str) {
    if ((loader->search_index) > 0 && loader->token[(loader->search_index)].type == JSMN_STRING) {
        int size = loader->token[(loader->search_index)].end - loader->token[(loader->search_index)].start;
        
        strncpy(str, loader->json_string + loader->token[(loader->search_index)].start, size);

        return 0;
    }

    return -1;
}
