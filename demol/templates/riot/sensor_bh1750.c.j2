#include "sensor_{{ name }}_{{ index }}.h"
#include "thread.h"
#include "xtimer.h"
#include "json_handler.h"
#include "mqtt_broker.h"
#include "bh1750fvi.h"

/*
 * Data wrapper so that alert property resolver can reference
 * data.illuminance — see bh1750.hwd PROPERTIES FOR riotos.
 */
typedef struct {
    uint16_t illuminance;
} {{ name }}_{{ index }}_data_t;

static bh1750fvi_t {{ name }}_{{ index }}_dev;
static {{ name }}_{{ index }}_data_t {{ name }}_{{ index }}_data;
static {{ name }}_{{ index }}_callback {{ name }}_{{ index }}_cb;

char {{ name }}_{{ index }}_json_payload[128] = "";
char {{ name }}_{{ index }}_stack[THREAD_STACKSIZE_MAIN];

void *{{ name }}_{{ index }}_thread(void *args);

int init_sensor_{{ name }}_{{ index }}(void)
{
    bh1750fvi_params_t params;
    params.i2c = I2C_DEV({{ conn.i2c.bus|default(0) }});
    params.addr = 0x{{ conn.i2c.slave_address|default('23') }};

    printf("Initialize {{ name|upper }} sensor ... ");
    if (bh1750fvi_init(&{{ name }}_{{ index }}_dev, &params) != BH1750FVI_OK)
    {
        puts("failed");
        return -1;
    }
    else
    {
        puts("OK");
        return 0;
    }
}

void start_sensor_{{ name }}_{{ index }}({{ name }}_{{ index }}_callback callback)
{
    {{ name }}_{{ index }}_cb = callback;
    thread_create({{ name }}_{{ index }}_stack, sizeof({{ name }}_{{ index }}_stack),
                  (THREAD_PRIORITY_MAIN + 1),
                  THREAD_CREATE_STACKTEST,
                  {{ name }}_{{ index }}_thread,
                  NULL, "{{ name }}_{{ index }}_sensor");
};

void *{{ name }}_{{ index }}_thread(void *args)
{
    (void)args;
{% if source_alerts %}
    /* ALERT cooldown trackers (function-scope statics persist across loop iterations) */
{% for a in source_alerts %}
    static uint64_t last_fire_{{ a.c_safe_name }} = 0;
{% endfor %}
{% endif %}
{% if sampling and sampling.mode == "on_change" %}
    uint16_t prev_illuminance = 0;
    int first_reading = 1;
{% endif %}
{% if sampling and sampling.mode == "batch" %}
    int batch_count = 0;
{% endif %}

    while (1)
    {
        {{ name }}_{{ index }}_data.illuminance = bh1750fvi_sample(&{{ name }}_{{ index }}_dev);

{% if source_alerts %}
        /* ALERT triggers — evaluated on every successful read, independent of sampling mode */
        uint64_t _now_sec = xtimer_now_usec64() / 1000000ULL;
{% for a in source_alerts %}
        if ({{ a.condition_c }}) {
            if ((_now_sec - last_fire_{{ a.c_safe_name }}) >= {{ a.cooldown_sec }}ULL) {
                last_fire_{{ a.c_safe_name }} = _now_sec;
{% for act in a.actions %}
                publish_alert("{{ act.payload_c }}", "{{ act.topic }}");
{% endfor %}
            }
        }
{% endfor %}
{% endif %}

{% if sampling and sampling.mode == "on_change" %}
        int changed = first_reading;
        if (!first_reading) {
            int diff = (int){{ name }}_{{ index }}_data.illuminance - (int)prev_illuminance;
            if (diff < 0) diff = -diff;
            if (diff > (int)({{ name|upper }}_{{ index }}_THRESHOLD)) {
                changed = 1;
            }
        }
        if (changed) {
            first_reading = 0;
            prev_illuminance = {{ name }}_{{ index }}_data.illuminance;

            json_dumps({{ name }}_{{ index }}_json_payload,
                       JSON_START,
                       JSON_KEY, "Illuminance", JSON_INT, {{ name }}_{{ index }}_data.illuminance,
                       JSON_STOP);

            {{ name }}_{{ index }}_cb({{ name }}_{{ index }}_json_payload);
        }
{% elif sampling and sampling.mode == "batch" %}
        batch_count++;
        if (batch_count >= {{ name|upper }}_{{ index }}_BATCH_SIZE) {
            json_dumps({{ name }}_{{ index }}_json_payload,
                       JSON_START,
                       JSON_KEY, "Illuminance", JSON_INT, {{ name }}_{{ index }}_data.illuminance,
                       JSON_KEY, "batch_count", JSON_INT, batch_count,
                       JSON_STOP);

            {{ name }}_{{ index }}_cb({{ name }}_{{ index }}_json_payload);
            batch_count = 0;
        }
{% else %}
        printf("[{{ name|upper }}]: Illuminance = %d lux\n", {{ name }}_{{ index }}_data.illuminance);

        json_dumps({{ name }}_{{ index }}_json_payload,
                   JSON_START,
                   JSON_KEY, "Illuminance", JSON_INT, {{ name }}_{{ index }}_data.illuminance,
                   JSON_STOP);

        {{ name }}_{{ index }}_cb({{ name }}_{{ index }}_json_payload);
{% endif %}

        xtimer_msleep(({{ name|upper }}_{{ index }}_FREQ));
    }
};
