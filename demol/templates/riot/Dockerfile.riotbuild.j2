# Dockerfile for self-contained DeMoL RIOT build environment
# Generated by DeMoL — do not edit by hand
#
# Builds on top of the upstream riot/riotbuild image and bakes a pinned
# RIOT source tree into /riot so the generated application can be built
# without requiring the user to clone RIOT separately.

FROM riot/riotbuild:latest

# RIOT release tag baked into this image. Override with --build-arg if needed.
ARG RIOT_VERSION={{ riot_version | default('2024.10') }}
ARG RIOT_REPO={{ riot_repo | default('https://github.com/RIOT-OS/RIOT.git') }}

ENV RIOTBASE=/riot
ENV DEBIAN_FRONTEND=noninteractive

# Clone RIOT at the requested release tag (shallow, single branch).
RUN git clone --depth 1 --branch ${RIOT_VERSION} ${RIOT_REPO} ${RIOTBASE}

# Pre-create the esptools venv path so the host bind-mount workaround
# (anonymous volume on /riot/dist/tools/esptools/venv) does not collide
# with first-run initialization inside the container.
RUN mkdir -p ${RIOTBASE}/dist/tools/esptools \
    && python3 -m venv ${RIOTBASE}/dist/tools/esptools/venv || true

WORKDIR /data/app

CMD ["/bin/bash"]
