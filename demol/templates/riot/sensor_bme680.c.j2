#include "sensor_{{ name }}_{{ index }}.h"
#include "thread.h"
#include "xtimer.h"
#include "json_handler.h"
#include "mqtt_broker.h"
#include "bme680.h"

static {{ name }}_t {{ name }}_{{ index }}_dev;
static {{ name }}_{{ index }}_callback {{ name }}_{{ index }}_cb;

char {{ name }}_{{ index }}_json_payload[165] = "";
char {{ name }}_{{ index }}_stack[THREAD_STACKSIZE_MAIN];

void *{{ name }}_{{ index }}_thread(void *args);

int init_sensor_{{ name }}_{{ index }}(void)
{
    bme680_params_t params;
    params.ifsel = BME680_I2C_INTF;
    params.intf.i2c.dev = I2C_DEV({{ conn.i2c.bus|default(0) }});
    params.intf.i2c.addr = 0x{{ conn.i2c.slave_address|default('77') }};
    params.temp_os = BME680_OS_{{ attributes.temperature_oversample|default('8') }}X;
    params.pres_os = BME680_OS_{{ attributes.pressure_oversample|default('4') }}X;
    params.hum_os = BME680_OS_{{ attributes.humidity_oversample|default('2') }}X;
    params.filter = BME680_FILTER_SIZE_{{ attributes.filter_size|default('3') }};
    params.gas_measure = BME680_ENABLE_GAS_MEAS;
    params.heater_temp = {{ attributes.heater_temp|default('320') }};
    params.heater_dur = {{ attributes.heater_duration|default('150') }};

    BME680_SENSOR(&{{ name }}_{{ index }}_dev).amb_temp = 25;

    printf("Initialize {{ name|upper }} sensor ... ");
    if ({{ name }}_init(&{{ name }}_{{ index }}_dev, &params) != {{ name|upper }}_OK)
    {
        puts("failed");
        return -1;
    }
    else
    {
        puts("OK");
        return 0;
    }
}

void start_sensor_{{ name }}_{{ index }}({{ name }}_{{ index }}_callback callback)
{
    {{ name }}_{{ index }}_cb = callback;
    thread_create({{ name }}_{{ index }}_stack, sizeof({{ name }}_{{ index }}_stack),
                  (THREAD_PRIORITY_MAIN + 1),
                  THREAD_CREATE_STACKTEST,
                  {{ name }}_{{ index }}_thread,
                  NULL, "{{ name }}_{{ index }}_sensor");
};

void *{{ name }}_{{ index }}_thread(void *args)
{
    (void)args;
    struct {{ name }}_field_data data;
{% if source_alerts %}
    /* ALERT cooldown trackers (function-scope statics persist across loop iterations) */
{% for a in source_alerts %}
    static uint64_t last_fire_{{ a.c_safe_name }} = 0;
{% endfor %}
{% endif %}
{% if sampling and sampling.mode == "on_change" %}
    int32_t prev_temperature = 0;
    uint32_t prev_pressure = 0;
    int32_t prev_humidity = 0;
    int first_reading = 1;
{% endif %}
{% if sampling and sampling.mode == "batch" %}
    int batch_count = 0;
{% endif %}

    while (1)
    {
        {{ name }}_force_measurement(&{{ name }}_{{ index }}_dev);

        int duration = {{ name }}_get_duration(&{{ name }}_{{ index }}_dev);
        xtimer_msleep(duration);
        int res = {{ name }}_get_data(&{{ name }}_{{ index }}_dev, &data);

        if (res == 0 && {{ name }}_{{ index }}_dev.sensor.new_fields)
        {
{% if source_alerts %}
            /* ALERT triggers — evaluated on every successful read, independent of sampling mode */
            uint64_t _now_sec = xtimer_now_usec64() / 1000000ULL;
{% for a in source_alerts %}
            if ({{ a.condition_c }}) {
                if ((_now_sec - last_fire_{{ a.c_safe_name }}) >= {{ a.cooldown_sec }}ULL) {
                    last_fire_{{ a.c_safe_name }} = _now_sec;
{% for act in a.actions %}
                    publish_alert("{{ act.payload_c }}", "{{ act.topic }}");
{% endfor %}
                }
            }
{% endfor %}
{% endif %}
{% if sampling and sampling.mode == "on_change" %}
            int changed = first_reading;
            if (!first_reading) {
                int32_t threshold = (int32_t)({{ name|upper }}_{{ index }}_THRESHOLD * 100);
                if (abs(data.temperature - prev_temperature) > threshold ||
                    abs((int32_t)(data.pressure - prev_pressure)) > threshold ||
                    abs(data.humidity - prev_humidity) > threshold) {
                    changed = 1;
                }
            }
            if (changed) {
                first_reading = 0;
                prev_temperature = data.temperature;
                prev_pressure = data.pressure;
                prev_humidity = data.humidity;

                json_dumps({{ name }}_{{ index }}_json_payload,
                           JSON_START,
                           JSON_KEY, "Temperature", JSON_INT, data.temperature,
                           JSON_KEY, "Pressure", JSON_INT, data.pressure,
                           JSON_KEY, "Humidity", JSON_INT, data.humidity,
                           JSON_STOP);

                {{ name }}_{{ index }}_cb({{ name }}_{{ index }}_json_payload);
            }
{% elif sampling and sampling.mode == "batch" %}
            batch_count++;
            if (batch_count >= {{ name|upper }}_{{ index }}_BATCH_SIZE) {
                json_dumps({{ name }}_{{ index }}_json_payload,
                           JSON_START,
                           JSON_KEY, "Temperature", JSON_INT, data.temperature,
                           JSON_KEY, "Pressure", JSON_INT, data.pressure,
                           JSON_KEY, "Humidity", JSON_INT, data.humidity,
                           JSON_KEY, "batch_count", JSON_INT, batch_count,
                           JSON_STOP);

                {{ name }}_{{ index }}_cb({{ name }}_{{ index }}_json_payload);
                batch_count = 0;
            }
{% else %}
            json_dumps({{ name }}_{{ index }}_json_payload,
                       JSON_START,
                       JSON_KEY, "Temperature", JSON_INT, data.temperature,
                       JSON_KEY, "Pressure", JSON_INT, data.pressure,
                       JSON_KEY, "Humidity", JSON_INT, data.humidity,
                       JSON_STOP);

            {{ name }}_{{ index }}_cb({{ name }}_{{ index }}_json_payload);
{% endif %}
        }
        else if (res == 0)
        {
            printf("[{{ name }}]: no new data\n");
        }
        else
        {
            printf("[{{ name }}]: read data failed with reason %d\n", res);
        }

        xtimer_msleep(({{ name|upper }}_{{ index }}_FREQ));
    }
};
