    'src/constraint.c': '''
      /*
       * Zephyr CONSTRAINT runtime — implementation.
       * Generated by demol for WemosConstraintBME680.
       *
       * Threading model:
       *   - constraint_mutex guards _devices[] and _device_count.
       *   - register_peripheral() is safe to call from any Zephyr thread.
       *   - The periodic check is dispatched on the system workqueue via
       *     k_work_delayable, with a 10-second default interval.
       *
       * Failure action (per design doc §4.3):
       *   - LOG_WRN with the constraint name and message.
       *   - atomic_inc(&constraint_failures) for downstream ALERT triggers.
       */
      #include <zephyr/kernel.h>
      #include <zephyr/logging/log.h>
      
      #include "constraint.h"
      
      /* Forward declarations: predicates below call these helpers before their
       * definitions (Zephyr builds with -Werror, so implicit declarations fail). */
      static uint8_t _count_kind(uint8_t kind);
      static uint8_t _count_connected(void);
      static int32_t _sum_power_mW(void);
      static int32_t _max_power_mW(void);
      
      LOG_MODULE_REGISTER(constraint, LOG_LEVEL_WRN);
      
      #define CONSTRAINT_CHECK_INTERVAL_S 10
      
      K_MUTEX_DEFINE(constraint_mutex);
      atomic_t constraint_failures = ATOMIC_INIT(0);
      
      static struct periph_state _devices[DEMOL_MAX_PERIPHERALS];
      static uint8_t _device_count = 0;
      
      static struct k_work_delayable _constraint_work;
      
      /* Predicate for CONSTRAINT power_ok: Total peripheral power exceeds 100 mW budget */
      bool _eval_constraint_power_ok(void)
      {
      	return (((_sum_power_mW()) < (100)));
      }
      
      struct constraint_entry {
      	const char *name;
      	const char *message;
      	bool (*eval)(void);
      };
      
      static const struct constraint_entry _constraints[] = {
      	{ "power_ok", "Total peripheral power exceeds 100 mW budget", _eval_constraint_power_ok },
      };
      #define _CONSTRAINT_COUNT (sizeof(_constraints) / sizeof(_constraints[0]))
      
      /* ---------------------------------------------------------------------- */
      /* Helpers guarded by constraint_mutex                                     */
      /* ---------------------------------------------------------------------- */
      
      static uint8_t _count_kind(uint8_t kind)
      {
      	uint8_t n = 0;
      
      	k_mutex_lock(&constraint_mutex, K_FOREVER);
      	for (uint8_t i = 0; i < _device_count; i++) {
      		if (_devices[i].kind == kind) {
      			n++;
      		}
      	}
      	k_mutex_unlock(&constraint_mutex);
      	return n;
      }
      
      static uint8_t _count_connected(void)
      {
      	uint8_t n = 0;
      
      	k_mutex_lock(&constraint_mutex, K_FOREVER);
      	for (uint8_t i = 0; i < _device_count; i++) {
      		if (_devices[i].connected) {
      			n++;
      		}
      	}
      	k_mutex_unlock(&constraint_mutex);
      	return n;
      }
      
      static int32_t _sum_power_mW(void)
      {
      	int32_t total = 0;
      
      	k_mutex_lock(&constraint_mutex, K_FOREVER);
      	for (uint8_t i = 0; i < _device_count; i++) {
      		if (_devices[i].power_mW >= 0) {
      			total += _devices[i].power_mW;
      		}
      	}
      	k_mutex_unlock(&constraint_mutex);
      	return total;
      }
      
      static int32_t _max_power_mW(void)
      {
      	int32_t peak = 0;
      
      	k_mutex_lock(&constraint_mutex, K_FOREVER);
      	for (uint8_t i = 0; i < _device_count; i++) {
      		if (_devices[i].power_mW > peak) {
      			peak = _devices[i].power_mW;
      		}
      	}
      	k_mutex_unlock(&constraint_mutex);
      	return peak;
      }
      
      void register_peripheral(const char *name, uint8_t kind, int32_t power_mW)
      {
      	k_mutex_lock(&constraint_mutex, K_FOREVER);
      	if (_device_count < DEMOL_MAX_PERIPHERALS) {
      		_devices[_device_count].name = name;
      		_devices[_device_count].kind = kind;
      		_devices[_device_count].power_mW = power_mW;
      		_devices[_device_count].connected = true;
      		_device_count++;
      	}
      	k_mutex_unlock(&constraint_mutex);
      }
      
      static void _constraint_work_handler(struct k_work *work)
      {
      	ARG_UNUSED(work);
      	check_constraints();
      	k_work_schedule(&_constraint_work, K_SECONDS(CONSTRAINT_CHECK_INTERVAL_S));
      }
      
      void constraint_init(void)
      {
      	k_work_schedule(&_constraint_work, K_SECONDS(CONSTRAINT_CHECK_INTERVAL_S));
      }
      
      void check_constraints(void)
      {
      	/* _constraints[] is a const table populated at init time, so we
      	 * don't need to hold constraint_mutex while iterating. Each
      	 * predicate function internally takes the lock when it reads
      	 * _devices[]. */
      	for (size_t i = 0; i < _CONSTRAINT_COUNT; i++) {
      		const struct constraint_entry *c = &_constraints[i];
      
      		if (c->eval()) {
      			continue;
      		}
      		atomic_inc(&constraint_failures);
      		LOG_WRN("[Constraint-Violated] %s: %s",
      			c->name,
      			c->message ? c->message : "expression is false");
      	}
      }
    ''',
    'src/constraint.h': '''
      /*
       * Zephyr CONSTRAINT runtime — public API.
       * Generated by demol for WemosConstraintBME680.
       *
       * Each declared CONSTRAINT becomes a predicate function that the periodic
       * k_work_delayable callback invokes via check_constraints(). The state mutex
       * is exposed so peripheral drivers can register themselves safely from any
       * Zephyr thread context.
       */
      #ifndef DEMOL_CONSTRAINT_H_
      #define DEMOL_CONSTRAINT_H_
      
      #include <zephyr/kernel.h>
      
      #ifdef __cplusplus
      extern "C" {
      #endif
      
      /* Maximum number of peripherals tracked by the constraint runtime. Mirrors
       * the design doc §4.1 value and is shared with constraint.c. */
      #ifndef DEMOL_MAX_PERIPHERALS
      #define DEMOL_MAX_PERIPHERALS 16
      #endif
      
      /* Peripheral kind codes used by the constraint runtime. Values match the
       * built-in function table in docs/constraint-runtime-design.md §4.1. */
      #define DEMOL_KIND_SENSOR     0
      #define DEMOL_KIND_ACTUATOR   1
      #define DEMOL_KIND_PERIPHERAL 2
      
      /* Per-peripheral runtime state. Drivers call register_peripheral() to fill
       * their slot; the constraint predicates then read these fields under
       * constraint_mutex. */
      struct periph_state {
      	const char *name;
      	uint8_t kind;
      	int32_t power_mW;     /* -1 if unknown / not measured */
      	bool connected;
      };
      
      /* Process-wide mutex protecting _devices[]. Drivers acquire it inside
       * register_peripheral() so the table stays consistent under concurrent
       * registration. */
      extern struct k_mutex constraint_mutex;
      
      /* Process-wide counter of constraint failures. Read by check_constraints()
       * on each tick, and exposed for the ALERT subsystem to query. */
      extern atomic_t constraint_failures;
      
      /* Register a peripheral with the constraint runtime. Must be called once
       * per peripheral during its init path. power_mW == -1 means "unknown". */
      void register_peripheral(const char *name, uint8_t kind, int32_t power_mW);
      
      /* Initialise the constraint runtime. Call from main() before k_sleep().
       * Schedules the periodic check work item. */
      void constraint_init(void);
      
      /* Evaluate every declared CONSTRAINT and log/inc on failure. Safe to call
       * from any thread; acquires constraint_mutex briefly per predicate. */
      void check_constraints(void);
      
      /* Predicate for CONSTRAINT power_ok. */
      bool _eval_constraint_power_ok(void);
      
      #ifdef __cplusplus
      }
      #endif
      
      #endif /* DEMOL_CONSTRAINT_H_ */
    ''',
