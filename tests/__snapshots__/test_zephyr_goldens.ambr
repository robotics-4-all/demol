              compatible = "demol,dht22";
              status = "okay";
              gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
              data-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
          };
      };
  
    ''',
    'dts/bindings/demol-dht22.yaml': '''
