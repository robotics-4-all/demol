          ds18b20_0: ds18b20_0 {
              compatible = "demol,ds18b20";
              status = "okay";
              gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
              data-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
          };
      };
  
