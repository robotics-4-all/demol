      {
              mqtt_init();
              return 0;
      }
  
    ''',
    'src/pir_hcsr501.c': '''
      /*
       * Zephyr PIR_HCSR501 driver (GPIO motion sensor).
       * Generated by demol — uses Zephyr's gpio_dt_spec for digital input.
       */
      
      #include <zephyr/device.h>
      #include <zephyr/drivers/gpio.h>
      
      #include "pir_hcsr501.h"
      
      static const struct gpio_dt_spec pir = GPIO_DT_SPEC_GET(DT_INST(0, demol_pir_hcsr501), gpios);
      
      int pir_hcsr501_init(void)
      {
          if (!gpio_is_ready_dt(&pir)) {
              return -ENODEV;
          }
          return gpio_pin_configure_dt(&pir, GPIO_INPUT);
      }
      
      int pir_hcsr501_read(bool *motion)
      {
          int val = gpio_pin_get_dt(&pir);
          if (val < 0) {
              return val;
          }
          *motion = (val != 0);
          return 0;
      }
    ''',
    'src/pir_hcsr501.h': '''
