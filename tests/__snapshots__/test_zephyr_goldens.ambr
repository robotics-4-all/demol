    'src/shtc3.c': '''
      /*
       * Zephyr SHTC3 driver (I2C temp/humidity sensor).
       * Generated by demol — uses Zephyr's built-in sensirion,shtc3 sensor
       * driver via the unified sensor_sample_fetch / sensor_channel_get API.
       */
      
      #include <zephyr/device.h>
      #include <zephyr/drivers/sensor.h>
      
      #include "shtc3.h"
      
      static const struct device *shtc3_dev = DEVICE_DT_GET(DT_INST(0, sensirion_shtc3));
      
      int shtc3_init(void)
      {
          if (!device_is_ready(shtc3_dev)) {
              return -ENODEV;
          }
          return 0;
      }
      
      int shtc3_read(struct shtc3_data *data)
      {
          struct sensor_value t = {0};
          struct sensor_value h = {0};
      
          if (sensor_sample_fetch(shtc3_dev) < 0) {
              return -EIO;
          }
      
          sensor_channel_get(shtc3_dev, SENSOR_CHAN_AMBIENT_TEMP, &t);
          sensor_channel_get(shtc3_dev, SENSOR_CHAN_HUMIDITY, &h);
      
          data->temperature = sensor_value_to_double(&t);
          data->humidity    = sensor_value_to_double(&h);
          return 0;
      }
    ''',
    'src/shtc3.h': '''
      /*
       * Zephyr SHTC3 driver — public API.
       * Generated by demol.
       */
