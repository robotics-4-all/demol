  dict({
    'CMakeLists.txt': '''
      cmake_minimum_required(VERSION 3.20.0)
      find_package(Zephyr REQUIRED HINTS $ENV{ZEPHYR_BASE})
      project(esp8266)
      target_sources(app PRIVATE src/main.c src/srf05.c)
      target_include_directories(app PRIVATE src)
    ''',
    'boards/esp8266.overlay': '''
      /* Generated by demol */
      / {
          srf05_0: srf05_0 {
              compatible = "demol,srf05";
              status = "okay";
              gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
              trigger-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
              echo-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
          };
      };
  
    ''',
    'dts/bindings/demol-srf05.yaml': '''
      description: Srf05 sensor
      compatible: "demol,srf05"
      
      properties:
        gpios:
          type: phandle-array
          required: true
          description: Canonical GPIO pin (first pin)
        trigger-gpios:
          type: phandle-array
          required: true
          description: GPIO trigger pin
        echo-gpios:
          type: phandle-array
          required: true
          description: GPIO echo pin
  
    ''',
    'prj.conf': '''
      # Generated by demol
      CONFIG_GPIO=y
      # MQTT client stack (T16 — skeleton only)
      CONFIG_NET_IPV4=y
      CONFIG_NET_TCP=y
      CONFIG_NET_SOCKETS=y
      CONFIG_NET_SOCKETS_OFFLOAD=n
      CONFIG_NET_DHCPV4=y
      CONFIG_MQTT_LIB=y
  
    ''',
    'src/main.c': '''
      /*
       * Zephyr application entry point.
       * Generated by demol -- driver logic is added in a later task.
       */
      
      #include <zephyr/kernel.h>
      #include <zephyr/net/mqtt.h>
      #include <zephyr/net/socket.h>
      
      static struct mqtt_client client;
      
      static void mqtt_init(void)
      {
              /* T16 skeleton: broker.connect, client.init.
               * Full publish loop is implemented in a later task.
               */
      }
      
      int main(void)
      {
              mqtt_init();
              return 0;
      }
  
    ''',
    'src/srf05.c': '''
      /*
       * Zephyr SRF05 driver (trigger-echo ultrasonic distance sensor).
       * Generated by demol — direct GPIO bit-bang driver. Expects a node
       * with compatible = "demol,srf05" and trigger/echo gpios properties.
       */
      
      #include <zephyr/device.h>
      #include <zephyr/drivers/gpio.h>
      #include <zephyr/kernel.h>
      
      #include "srf05.h"
      
      static const struct gpio_dt_spec srf05_trigger =
      	GPIO_DT_SPEC_GET(DT_INST(0, demol_srf05), trigger_gpios);
      static const struct gpio_dt_spec srf05_echo =
      	GPIO_DT_SPEC_GET(DT_INST(0, demol_srf05), echo_gpios);
      
      int srf05_init(void)
      {
      	if (!device_is_ready(srf05_trigger.port) ||
      	    !device_is_ready(srf05_echo.port)) {
      		return -ENODEV;
      	}
      	gpio_pin_configure_dt(&srf05_trigger, GPIO_OUTPUT_INACTIVE);
      	return gpio_pin_configure_dt(&srf05_echo, GPIO_INPUT);
      }
      
      /* Speed of sound ~343 m/s: 1 cm round-trip takes ~58 us. */
      #define SRF05_US_PER_CM 58U
      
      int srf05_read_cm(uint32_t timeout_us)
      {
      	uint32_t width = 0;
      
      	/* 10 us trigger pulse. */
      	gpio_pin_set_dt(&srf05_trigger, 1);
      	k_busy_wait(10);
      	gpio_pin_set_dt(&srf05_trigger, 0);
      
      	/* Wait for the echo line to rise. */
      	while (!gpio_pin_get_dt(&srf05_echo)) {
      		if (++width > timeout_us) {
      			return -ETIMEDOUT;
      		}
      		k_busy_wait(1);
      	}
      
      	/* Measure the echo pulse width. */
      	width = 0;
      	while (gpio_pin_get_dt(&srf05_echo)) {
      		if (++width > timeout_us) {
      			return -ETIMEDOUT;
      		}
      		k_busy_wait(1);
      	}
      
      	return (int)(width / SRF05_US_PER_CM);
      }
    ''',
    'src/srf05.h': '''
      /*
       * Zephyr SRF05 driver — public API.
       * Generated by demol — trigger-echo ultrasonic distance sensor.
       */
      #ifndef DEMOL_SRF05_H_
      #define DEMOL_SRF05_H_
      
      #include <stdint.h>
      
      int srf05_init(void);
      int srf05_read_cm(uint32_t timeout_us);
      
      #endif /* DEMOL_SRF05_H_ */
    ''',
  })
