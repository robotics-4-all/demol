          description: GPIO state pin
  
    ''',
    'prj.conf': '''
      # Generated by demol
      CONFIG_GPIO=y
      # MQTT client stack (T16 — skeleton only)
      CONFIG_NET_IPV4=y
      CONFIG_NET_TCP=y
      CONFIG_NET_SOCKETS=y
