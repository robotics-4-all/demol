      / {
          ds18b20_0: ds18b20_0 {
              compatible = "demol,ds18b20";
              status = "okay";
              gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
              data-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
          };
      };
  
    ''',
    'dts/bindings/demol-ds18b20.yaml': '''
