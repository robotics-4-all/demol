  dict({
    'CMakeLists.txt': '''
      cmake_minimum_required(VERSION 3.20.0)
      find_package(Zephyr REQUIRED HINTS $ENV{ZEPHYR_BASE})
      project(esp8266)
      target_sources(app PRIVATE src/main.c src/dht22.c)
      target_include_directories(app PRIVATE src/include)
    ''',
    'boards/esp8266.overlay': '''
      /* Generated by demol */
      / {
          dht22_0: dht22_0 {
              compatible = "demol,dht22";
              status = "okay";
              data-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
          };
      };
  
    ''',
    'dts/bindings/demol-dht22.yaml': '''
      description: Dht22 sensor
      compatible: "demol,dht22"
      
      properties:
        data-gpios:
          type: phandle-array
          required: true
          description: GPIO data pin
  
    ''',
    'prj.conf': '''
      # Generated by demol
      CONFIG_DHT22=y
      # MQTT client stack (T16 — skeleton only)
      CONFIG_NET_IPV4=y
      CONFIG_NET_TCP=y
      CONFIG_NET_SOCKETS=y
      CONFIG_NET_SOCKETS_OFFLOAD=n
      CONFIG_NET_DHCPV4=y
      CONFIG_MQTT_LIB=y
  
    ''',
    'src/dht22.c': '''
      /*
       * Zephyr DHT22 driver (GPIO bit-bang temperature/humidity sensor).
       * Generated by demol — implements the timing-sensitive DHT22 protocol
       * using Zephyr GPIO API with microsecond-precision delays.
       */
      
      #include <zephyr/kernel.h>
      #include <zephyr/device.h>
      #include <zephyr/drivers/gpio.h>
      
      #include "dht22.h"
      
      /* ------------------------------------------------------------------
       * Devicetree reference — expects a node with compatible = "demol,dht22"
       * and a "data-gpios" phandle-array property in the board overlay.
       * ---------------------------------------------------------------- */
      static const struct gpio_dt_spec dht22_data =
          GPIO_DT_SPEC_GET(DT_INST(0, demol_dht22), data_gpios);
      
      /* ------------------------------------------------------------------
       * Protocol timing constants (microseconds).
       *
       *           Minimum  Typical  Maximum
       * Start LOW    800    1000    10000
       * Start HIGH    20      30       50
       * Response LOW  75      80      100
       * Response HIGH 75      80      100
       * Bit LOW       48      50       56
       * Bit "0" HIGH  22      26       30
       * Bit "1" HIGH  68      70       75
       * ---------------------------------------------------------------- */
      #define DHT22_START_LOW_US      1800
      #define DHT22_START_HIGH_US      30
      #define DHT22_RESPONSE_WAIT_US  120
      #define DHT22_BIT_LOW_MIN_US     30
      #define DHT22_BIT_SAMPLE_US      40
      #define DHT22_RECOVERY_MS         1
      
      /* ------------------------------------------------------------------
       * Data structure returned by dht22_read().
       * ---------------------------------------------------------------- */
      struct dht22_data {
          double temperature;
          double humidity;
      };
      
      /* ------------------------------------------------------------------
       * dht22_init — configure the data pin, pull high (idle state).
       * ---------------------------------------------------------------- */
      int dht22_init(void)
      {
          if (!device_is_ready(dht22_data.port)) {
              return -ENODEV;
          }
      
          /* Start in output-high (idle bus state for DHT22).
           * GPIO_OPEN_DRAIN + pull-up would be ideal but we manage the
           * pin direction manually for precise timing control. */
          gpio_pin_configure_dt(&dht22_data, GPIO_OUTPUT_HIGH);
          return 0;
      }
      
      /* ------------------------------------------------------------------
       * dht22_pulse_in — measure the width of a HIGH pulse (in �s).
       * Returns 0 on timeout.
       * ---------------------------------------------------------------- */
      static uint32_t dht22_pulse_in(void)
      {
          uint32_t width = 0;
      
          /* Wait for pin to go HIGH */
          for (int i = 0; i < DHT22_RESPONSE_WAIT_US; i++) {
              if (gpio_pin_get_dt(&dht22_data)) {
                  break;
              }
              k_busy_wait(1);
              if (++width > DHT22_RESPONSE_WAIT_US) {
                  return 0;
              }
          }
      
          /* Measure how long it stays HIGH */
          width = 0;
          for (int i = 0; i < DHT22_RESPONSE_WAIT_US; i++) {
              if (!gpio_pin_get_dt(&dht22_data)) {
                  break;
              }
              k_busy_wait(1);
              if (++width > DHT22_RESPONSE_WAIT_US) {
                  return 0;
              }
          }
      
          return width;
      }
      
      /* ------------------------------------------------------------------
       * dht22_read_raw — send start signal, receive 40-bit frame.
       *
       * Returns 0 on success, -EIO on timeout or checksum mismatch.
       * ---------------------------------------------------------------- */
      static int dht22_read_raw(uint8_t buf[5])
      {
          int ret;
      
          /* ---- Send start signal ---- */
          gpio_pin_configure_dt(&dht22_data, GPIO_OUTPUT);
          gpio_pin_set_dt(&dht22_data, 0);
          k_busy_wait(DHT22_START_LOW_US);
          gpio_pin_set_dt(&dht22_data, 1);
          k_busy_wait(DHT22_START_HIGH_US);
      
          /* Switch to input — DHT22 will drive the bus */
          gpio_pin_configure_dt(&dht22_data, GPIO_INPUT);
      
          /* ---- Wait for DHT22 response pulse ---- */
          /* LOW pulse (DHT22 pulls low ~80 us) */
          ret = gpio_pin_get_dt(&dht22_data) == 0;
          for (int i = 0; i < DHT22_RESPONSE_WAIT_US; i++) {
              if (gpio_pin_get_dt(&dht22_data)) {
                  break;
              }
              k_busy_wait(1);
          }
      
          /* HIGH pulse (DHT22 pulls high ~80 us) */
          for (int i = 0; i < DHT22_RESPONSE_WAIT_US; i++) {
              if (!gpio_pin_get_dt(&dht22_data)) {
                  break;
              }
              k_busy_wait(1);
          }
      
          /* ---- Read 40 data bits ---- */
          for (int bit = 0; bit < 40; bit++) {
              /* Each bit starts with ~50 us LOW */
              for (int i = 0; i < 60; i++) {
                  if (gpio_pin_get_dt(&dht22_data)) {
                      break;
                  }
                  k_busy_wait(1);
              }
      
              /* Sample after ~40 us — short HIGH = 0, long HIGH = 1 */
              k_busy_wait(DHT22_BIT_SAMPLE_US);
      
              uint32_t val = gpio_pin_get_dt(&dht22_data);
      
              /* Wait for pin to go LOW again before next bit */
              for (int i = 0; i < 60; i++) {
                  if (!gpio_pin_get_dt(&dht22_data)) {
                      break;
                  }
                  k_busy_wait(1);
              }
      
              int byte_idx = bit / 8;
              buf[byte_idx] = (buf[byte_idx] << 1) | (val ? 1 : 0);
          }
      
          /* Return pin to idle (output, high) */
          gpio_pin_configure_dt(&dht22_data, GPIO_OUTPUT_HIGH);
      
          return 0;
      }
      
      /* ------------------------------------------------------------------
       * dht22_read — read temperature (�C) and humidity (%RH).
       *
       * Populates data->temperature and data->humidity as doubles.
       * Returns 0 on success, -EIO on failure.
       * ---------------------------------------------------------------- */
      int dht22_read(struct dht22_data *data)
      {
          uint8_t buf[5] = {0};
      
          if (!data) {
              return -EINVAL;
          }
      
          if (dht22_read_raw(buf) < 0) {
              return -EIO;
          }
      
          /* Verify checksum */
          uint8_t sum = buf[0] + buf[1] + buf[2] + buf[3];
          if ((sum & 0xFF) != buf[4]) {
              return -EIO;
          }
      
          /* Decode humidity (16 bits, integer.decimal) */
          uint16_t hum_raw = ((uint16_t)buf[0]) << 8 | buf[1];
          data->humidity = hum_raw * 0.1;
      
          /* Decode temperature (16 bits, signed, integer.decimal) */
          int16_t temp_raw = ((int16_t)(buf[2] & 0x7F)) << 8 | buf[3];
          if (buf[2] & 0x80) {
              temp_raw = -temp_raw;
          }
          data->temperature = temp_raw * 0.1;
      
          return 0;
      }
    ''',
    'src/main.c': '''
      /*
       * Zephyr application entry point.
       * Generated by demol -- driver logic is added in a later task.
       */
      
      #include <zephyr/kernel.h>
      #include <zephyr/net/mqtt.h>
      #include <zephyr/net/socket.h>
      
      static struct mqtt_client client;
      
      static void mqtt_init(void)
      {
              /* T16 skeleton: broker.connect, client.init.
               * Full publish loop is implemented in a later task.
               */
      }
      
      int main(void)
      {
              mqtt_init();
              return 0;
      }
  
    ''',
  })
