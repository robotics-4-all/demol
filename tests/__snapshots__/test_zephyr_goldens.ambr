    'src/bme280.c': '''
      /*
       * Zephyr BME280 driver (env sensor: temperature, pressure, humidity).
       * Generated by demol — uses Zephyr's built-in bosch,bme280 sensor
       * driver via the unified sensor_sample_fetch / sensor_channel_get API.
       */
      
      #include <zephyr/device.h>
      #include <zephyr/drivers/sensor.h>
      
      #include "bme280.h"
      
      static const struct device *bme280_dev = DEVICE_DT_GET(DT_INST(0, bosch_bme280));
      
      int bme280_init(void)
      {
          if (!device_is_ready(bme280_dev)) {
              return -ENODEV;
          }
          return 0;
      }
      
      int bme280_read(struct bme280_data *data)
      {
          struct sensor_value t = {0};
          struct sensor_value p = {0};
          struct sensor_value h = {0};
      
          if (sensor_sample_fetch(bme280_dev) < 0) {
              return -EIO;
          }
      
          sensor_channel_get(bme280_dev, SENSOR_CHAN_AMBIENT_TEMP, &t);
          sensor_channel_get(bme280_dev, SENSOR_CHAN_PRESS, &p);
          sensor_channel_get(bme280_dev, SENSOR_CHAN_HUMIDITY, &h);
      
          data->temperature = sensor_value_to_double(&t);
          data->pressure    = sensor_value_to_double(&p);
          data->humidity    = sensor_value_to_double(&h);
          return 0;
      }
