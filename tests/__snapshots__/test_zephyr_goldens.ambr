    'src/ads1115.c': '''
      /*
       * Zephyr ADS1115 driver (16-bit I2C ADC, 4 channels).
       * Generated by demol — uses Zephyr's built-in ti,ads1115 sensor driver
       * (when available) or a manual register-based implementation via i2c_dt_spec.
       */
      
      #include <zephyr/device.h>
      #include <zephyr/drivers/i2c.h>
      #include <zephyr/sys/byteorder.h>
      
      #include "ads1115.h"
      
      #define ADS1115_REG_CONVERSION  0x00
      #define ADS1115_REG_CONFIG      0x01
      #define ADS1115_REG_LO_THRESH   0x02
      #define ADS1115_REG_HI_THRESH   0x03
      
      static const struct i2c_dt_spec ads1115_i2c =
          I2C_DT_SPEC_GET(DT_INST(0, demol_ads1115));
      
      static int16_t ads1115_read_channel(uint8_t ch)
      {
          uint8_t buf[3];
          uint16_t config = 0x8000 | (0x4000) | (0x0080) | ((ch & 0x03) << 12) | 0x0100;
          /* OS=1 (start), MUX=AINx, PGA=±4.096V, MODE=single-conversion, DR=128SPS */
          config = sys_cpu_to_be16(config);
      
          buf[0] = ADS1115_REG_CONFIG;
          buf[1] = ((uint8_t *)&config)[0];
          buf[2] = ((uint8_t *)&config)[1];
          if (i2c_write_dt(&ads1115_i2c, buf, 3) < 0) return -1;
      
          /* Poll for conversion complete (~8ms @ 128SPS) */
          k_msleep(10);
      
          buf[0] = ADS1115_REG_CONVERSION;
          if (i2c_write_dt(&ads1115_i2c, buf, 1) < 0) return -1;
          if (i2c_read_dt(&ads1115_i2c, buf, 2) < 0) return -1;
          return (int16_t)sys_be16_to_cpu(*(uint16_t *)buf);
      }
      
      int ads1115_init(void)
      {
          if (!device_is_ready(ads1115_i2c.bus)) {
              return -ENODEV;
          }
          return 0;
      }
      
      int ads1115_read(int16_t values[4])
      {
          for (int i = 0; i < 4; i++) {
              values[i] = ads1115_read_channel(i);
              if (values[i] < 0) return -EIO;
          }
          return 0;
      }
    ''',
    'src/ads1115.h': '''
      /*
       * Zephyr ADS1115 driver — public API.
       * Generated by demol — 16-bit I2C ADC, 4 channels.
       */
      #ifndef DEMOL_ADS1115_H_
      #define DEMOL_ADS1115_H_
      
      #include <stdint.h>
      
      int ads1115_init(void);
      int ads1115_read(int16_t values[4]);
      
      #endif /* DEMOL_ADS1115_H_ */
    ''',
    'src/main.c': '''
