# name: test_zephyr_codegen_golden[wemos_bme680_alert][wemos_bme680_alert]
  dict({
    'CMakeLists.txt': '''
      cmake_minimum_required(VERSION 3.20.0)
      find_package(Zephyr REQUIRED HINTS $ENV{ZEPHYR_BASE})
      project(esp8266)
      target_sources(app PRIVATE src/main.c src/bme680.c)
      target_include_directories(app PRIVATE src)
    ''',
    'boards/esp8266.overlay': '''
      /* Generated by demol */
      &i2c0 { bme680@0x76 { status = "okay"; reg = <0x76>; compatible = "demol,bme680"; }; };
  
    ''',
    'dts/bindings/demol-bme680.yaml': '''
      description: Bme680 I2C sensor
      compatible: "demol,bme680"
      
      include: i2c-device.yaml
  
    ''',
    'prj.conf': '''
      # Generated by demol
      CONFIG_I2C=y
      # MQTT client stack (T16 — skeleton only)
      CONFIG_NET_IPV4=y
      CONFIG_NET_TCP=y
      CONFIG_NET_SOCKETS=y
      CONFIG_NET_SOCKETS_OFFLOAD=n
      CONFIG_NET_DHCPV4=y
      CONFIG_MQTT_LIB=y
  
    ''',
    'src/bme680.c': '''
      /*
       * Zephyr BME680 driver (env sensor: temperature, pressure, humidity).
       * Generated by demol — custom I2C forced-mode driver. Zephyr ships no
       * BME680 driver, so this implements the Bosch forced-mode flow directly:
       * soft-reset, calibration readout, oversample x1 + forced conversion,
       * and Bosch BME68x temperature / pressure / humidity compensation.
       * Gas sensing is intentionally out of scope (needs heater profiling).
       */
      
      #include <zephyr/device.h>
      #include <zephyr/drivers/i2c.h>
      #include <zephyr/kernel.h>
      
      #include "bme680.h"
      
      #define BME680_REG_CHIP_ID    0xD0
      #define BME680_CHIP_ID_VALUE  0x61
      #define BME680_REG_SOFT_RESET 0xE0
      #define BME680_SOFT_RESET_CMD 0xB6
      #define BME680_REG_CTRL_HUM   0x72
      #define BME680_REG_CTRL_MEAS  0x74
      #define BME680_REG_CONFIG     0x75
      #define BME680_REG_COEFF1     0x89
      #define BME680_REG_COEFF2     0xE1
      #define BME680_REG_DATA       0x1F
      #define BME680_OS_1X          0x01
      
      static const struct i2c_dt_spec bme680_i2c =
      	I2C_DT_SPEC_GET(DT_INST(0, demol_bme680));
      
      /* Calibration parameters, decoded once at init (all stored as double,
       * matching the float-based Bosch compensation flow). */
      struct bme680_calib {
      	double t1, t2, t3;
      	double p1, p2, p3, p4, p5, p6, p7, p8, p9, p10;
      	double h1, h2, h3, h4, h5, h6, h7;
      };
      
      static struct bme680_calib calib;
      static bool calib_valid;
      
      static int bme680_reg_read(uint8_t reg, uint8_t *buf, size_t len)
      {
      	return i2c_write_read_dt(&bme680_i2c, &reg, 1, buf, len);
      }
      
      static int bme680_reg_write(uint8_t reg, uint8_t val)
      {
      	uint8_t buf[2] = {reg, val};
      
      	return i2c_write_dt(&bme680_i2c, buf, sizeof(buf));
      }
      
      static uint16_t u16_le(const uint8_t *b)
      {
      	return (uint16_t)b[0] | ((uint16_t)b[1] << 8);
      }
      
      static int16_t s16_le(const uint8_t *b)
      {
      	return (int16_t)u16_le(b);
      }
      
      /* Decode one little-endian field out of the logical calibration image.
       * The image concatenates COEFF1[1..24] and COEFF2[0..13] (38 bytes). */
      static double calib_u8(const uint8_t *s, int off)
      {
      	return (double)s[off];
      }
      
      static double calib_s8(const uint8_t *s, int off)
      {
      	return (double)((int8_t)s[off]);
      }
      
      static double calib_u16(const uint8_t *s, int off)
      {
      	return (double)u16_le(&s[off]);
      }
      
      static double calib_s16(const uint8_t *s, int off)
      {
      	return (double)s16_le(&s[off]);
      }
      
      static int bme680_read_calib(void)
      {
      	uint8_t c1[25];
      	uint8_t c2[16];
      	uint8_t s[38];
      
      	if (bme680_reg_read(BME680_REG_COEFF1, c1, sizeof(c1)) < 0) {
      		return -EIO;
      	}
      	if (bme680_reg_read(BME680_REG_COEFF2, c2, sizeof(c2)) < 0) {
      		return -EIO;
      	}
      	for (int i = 0; i < 24; i++) {
      		s[i] = c1[1 + i];
      	}
      	for (int i = 0; i < 14; i++) {
      		s[24 + i] = c2[i];
      	}
      
      	calib.t1 = calib_u16(s, 32);
      	calib.t2 = calib_s16(s, 0);
      	calib.t3 = calib_s8(s, 2);
      
      	calib.p1 = calib_u16(s, 4);
      	calib.p2 = calib_s16(s, 6);
      	calib.p3 = calib_s8(s, 8);
      	calib.p4 = calib_s16(s, 10);
      	calib.p5 = calib_s16(s, 12);
      	calib.p6 = calib_s8(s, 15);
      	calib.p7 = calib_s8(s, 14);
      	calib.p8 = calib_s16(s, 18);
      	calib.p9 = calib_s16(s, 20);
      	calib.p10 = calib_u8(s, 22);
      
      	calib.h1 = calib_u16(s, 25);
      	calib.h2 = calib_u8(s, 24);
      	calib.h3 = calib_s8(s, 27);
      	calib.h4 = calib_s8(s, 28);
      	calib.h5 = calib_s8(s, 29);
      	calib.h6 = calib_u8(s, 30);
      	calib.h7 = calib_s8(s, 31);
      
      	return 0;
      }
      
      int bme680_init(void)
      {
      	uint8_t chip_id;
      
      	if (!device_is_ready(bme680_i2c.bus)) {
      		return -ENODEV;
      	}
      	if (bme680_reg_read(BME680_REG_CHIP_ID, &chip_id, 1) < 0) {
      		return -EIO;
      	}
      	if (chip_id != BME680_CHIP_ID_VALUE) {
      		return -ENODEV;
      	}
      	if (bme680_reg_write(BME680_REG_SOFT_RESET, BME680_SOFT_RESET_CMD) < 0) {
      		return -EIO;
      	}
      	k_msleep(10);
      	if (bme680_read_calib() < 0) {
      		return -EIO;
      	}
      	calib_valid = true;
      	return 0;
      }
      
      int bme680_read(struct bme680_data *data)
      {
      	uint8_t buf[8];
      	uint32_t press_raw, temp_raw;
      	uint16_t hum_raw;
      	double var1, var2, var3, var4, var5, var6;
      	double t_fine, temp_scaled, calc_pres, calc_hum;
      
      	if (!data || !calib_valid) {
      		return -EINVAL;
      	}
      
      	/* Oversample x1 for humidity, then trigger a forced TPH conversion. */
      	if (bme680_reg_write(BME680_REG_CTRL_HUM, BME680_OS_1X) < 0) {
      		return -EIO;
      	}
      	if (bme680_reg_write(BME680_REG_CTRL_MEAS,
      			     (BME680_OS_1X << 5) | (BME680_OS_1X << 2) | 0x01) < 0) {
      		return -EIO;
      	}
      	k_msleep(50);
      
      	if (bme680_reg_read(BME680_REG_DATA, buf, sizeof(buf)) < 0) {
      		return -EIO;
      	}
      
      	press_raw = ((uint32_t)buf[0] << 12) | ((uint32_t)buf[1] << 4) | (buf[2] >> 4);
      	temp_raw = ((uint32_t)buf[3] << 12) | ((uint32_t)buf[4] << 4) | (buf[5] >> 4);
      	hum_raw = ((uint16_t)buf[6] << 8) | buf[7];
      
      	/* Temperature (temp_scaled is 0.01 degC units). */
      	var1 = (temp_raw / 8.0) - (calib.t1 * 2.0);
      	var2 = (var1 * calib.t2) / 2048.0;
      	var3 = ((var1 / 2.0) * (var1 / 2.0)) / 4096.0;
      	var3 = (var3 * calib.t3 * 16.0) / 16384.0;
      	t_fine = var2 + var3;
      	temp_scaled = ((t_fine * 5.0) + 128.0) / 256.0;
      	data->temperature = temp_scaled / 100.0;
      
      	/* Pressure (Pa). */
      	var1 = (t_fine / 2.0) - 64000.0;
      	var2 = ((var1 / 4.0) * (var1 / 4.0)) / 2048.0;
      	var2 = (var2 * calib.p6) / 4.0;
      	var2 = var2 + (var1 * calib.p5 * 2.0);
      	var2 = (var2 / 4.0) + (calib.p4 * 65536.0);
      	var1 = ((((var1 / 4.0) * (var1 / 4.0)) / 8192.0) *
      		(calib.p3 * 32.0) / 8.0) + ((calib.p2 * var1) / 2.0);
      	var1 = var1 / 262144.0;
      	var1 = ((32768.0 + var1) * calib.p1) / 32768.0;
      	calc_pres = 1048576.0 - press_raw;
      	calc_pres = (calc_pres - (var2 / 4096.0)) * 3125.0;
      	if (var1 == 0.0) {
      		return -EIO;
      	}
      	calc_pres = (calc_pres / var1) * 2.0;
      	var1 = (calib.p9 * (((calc_pres / 8.0) * (calc_pres / 8.0)) / 8192.0)) / 4096.0;
      	var2 = ((calc_pres / 4.0) * calib.p8) / 8192.0;
      	var3 = (((calc_pres / 256.0) * (calc_pres / 256.0) *
      		 (calc_pres / 256.0)) * calib.p10) / 131072.0;
      	calc_pres += (var1 + var2 + var3 + (calib.p7 * 128.0)) / 16.0;
      	data->pressure = calc_pres;
      
      	/* Humidity (%RH). */
      	var1 = hum_raw - (calib.h1 * 16.0) - ((temp_scaled * calib.h3) / 200.0);
      	var2 = calib.h2 * (((temp_scaled * calib.h4) / 100.0) +
      		(((temp_scaled * ((temp_scaled * calib.h5) / 100.0)) / 64.0) / 100.0) +
      		16384.0) / 1024.0;
      	var3 = var1 * var2;
      	var4 = calib.h6 * 128.0;
      	var4 = (var4 + ((temp_scaled * calib.h7) / 100.0)) / 16.0;
      	var5 = ((var3 / 16384.0) * (var3 / 16384.0)) / 1024.0;
      	var6 = (var4 * var5) / 2.0;
      	calc_hum = (((var3 + var6) / 1024.0) * 1000.0) / 4096.0;
      	calc_hum /= 1000.0;
      	if (calc_hum > 100.0) {
      		calc_hum = 100.0;
      	} else if (calc_hum < 0.0) {
      		calc_hum = 0.0;
      	}
      	data->humidity = calc_hum;
      
      	return 0;
      }
    ''',
    'src/bme680.h': '''
      /*
       * Zephyr BME680 driver — public API.
       * Generated by demol — custom I2C forced-mode driver (no upstream
       * Zephyr driver exists for the BME680).
       */
      #ifndef DEMOL_BME680_H_
      #define DEMOL_BME680_H_
      
      #include <stdint.h>
      
      struct bme680_data {
          double temperature;
          double pressure;
          double humidity;
      };
      
      int bme680_init(void);
      int bme680_read(struct bme680_data *data);
      
      #endif /* DEMOL_BME680_H_ */
    ''',
    'src/main.c': '''
      #include "bme680.h"
      #include <zephyr/logging/log.h>
      /*
       * Zephyr application entry point.
       * Generated by demol -- ALERT trigger loop.
       */
      
      #include <zephyr/kernel.h>
      LOG_MODULE_REGISTER(app, LOG_LEVEL_INF);
      
      static struct bme680_data bme680_data = {0};
      static int64_t last_trigger_fever_alert_ms = 0;
      static int64_t last_trigger_humid_alert_ms = 0;
      
      void check_alerts(void)
      {
      	int64_t now_ms = k_uptime_get();
      	/* ALERT fever_alert on bme680 -- publish "my_wemos.alerts.fever" */
      	if ((bme680_data.temperature) > 38.5) {
      		if (last_trigger_fever_alert_ms == 0 ||
      		    (now_ms - last_trigger_fever_alert_ms) >= 60000) {
      			last_trigger_fever_alert_ms = now_ms;
      			LOG_INF("ALERT fever_alert: PUBLISH to my_wemos.alerts.fever");
      		}
      	}
      	/* ALERT humid_alert on bme680 -- publish "my_wemos.alerts.humidity" */
      	if ((bme680_data.humidity) > 75.0) {
      		if (last_trigger_humid_alert_ms == 0 ||
      		    (now_ms - last_trigger_humid_alert_ms) >= 30000) {
      			last_trigger_humid_alert_ms = now_ms;
      			LOG_INF("ALERT humid_alert: PUBLISH to my_wemos.alerts.humidity");
      		}
      	}
      }
      
      int main(void)
      {
      	while (1) {
      		check_alerts();
      		k_msleep(1000);
      	}
      	return 0;
      }
    ''',
  })
