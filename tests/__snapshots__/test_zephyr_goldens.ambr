    'src/bh1750.c': '''
      /*
       * Zephyr BH1750 driver (ambient light sensor).
       * Generated by demol — uses Zephyr's built-in rohm,bh1750 sensor
       * driver via the unified sensor_sample_fetch / sensor_channel_get API.
       */
      
      #include <zephyr/device.h>
      #include <zephyr/drivers/sensor.h>
      
      #include "bh1750.h"
      
      static const struct device *bh1750_dev = DEVICE_DT_GET(DT_INST(0, rohm_bh1750));
      
      int bh1750_init(void)
      {
          if (!device_is_ready(bh1750_dev)) {
              return -ENODEV;
          }
          return 0;
      }
      
      int bh1750_read(struct bh1750_data *data)
      {
          struct sensor_value lux = {0};
      
          if (sensor_sample_fetch(bh1750_dev) < 0) {
              return -EIO;
          }
      
          sensor_channel_get(bh1750_dev, SENSOR_CHAN_LIGHT, &lux);
      
          data->illuminance = sensor_value_to_double(&lux);
          return 0;
      }
