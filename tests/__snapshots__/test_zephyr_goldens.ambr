# name: test_zephyr_codegen_golden[wemos_button][wemos_button]
  dict({
    'CMakeLists.txt': '''
      cmake_minimum_required(VERSION 3.20.0)
      find_package(Zephyr REQUIRED HINTS $ENV{ZEPHYR_BASE})
      project(esp8266)
      target_sources(app PRIVATE src/main.c src/button.c)
      target_include_directories(app PRIVATE src)
    ''',
    'boards/esp8266.overlay': '''
      /* Generated by demol */
      / {
          tactilebutton_0: tactilebutton_0 {
              compatible = "demol,button";
              status = "okay";
              gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
              state-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
          };
      };
  
    ''',
    'dts/bindings/demol-button.yaml': '''
      description: Tactilebutton sensor
      compatible: "demol,button"
      
      properties:
        gpios:
          type: phandle-array
          required: true
          description: Canonical GPIO pin (first pin)
        state-gpios:
          type: phandle-array
          required: true
          description: GPIO state pin
  
    ''',
    'prj.conf': '''
      # Generated by demol
      CONFIG_GPIO=y
      # MQTT client stack (T16 — skeleton only)
      CONFIG_NET_IPV4=y
      CONFIG_NET_TCP=y
      CONFIG_NET_SOCKETS=y
      CONFIG_NET_SOCKETS_OFFLOAD=n
      CONFIG_NET_DHCPV4=y
      CONFIG_MQTT_LIB=y
  
    ''',
    'src/button.c': '''
      /*
       * Zephyr tactile button driver (GPIO input with interrupt).
       * Generated by demol — uses Zephyr's gpio_dt_spec + gpio_add_callback.
       */
      
      #include <zephyr/device.h>
      #include <zephyr/drivers/gpio.h>
      #include <zephyr/sys/util.h>
      
      #include "button.h"
      
      static const struct gpio_dt_spec button = GPIO_DT_SPEC_GET(DT_INST(0, demol_button), gpios);
      static struct gpio_callback button_cb;
      static void (*button_user_cb)(void);
      
      static void button_pressed(const struct device *dev, struct gpio_callback *cb, uint32_t pins)
      {
          ARG_UNUSED(dev);
          ARG_UNUSED(cb);
          ARG_UNUSED(pins);
          if (button_user_cb) {
              button_user_cb();
          }
      }
      
      int button_init(void (*callback)(void))
      {
          int ret;
      
          if (!gpio_is_ready_dt(&button)) {
              return -ENODEV;
          }
      
          button_user_cb = callback;
      
          ret = gpio_pin_configure_dt(&button, GPIO_INPUT);
          if (ret < 0) {
              return ret;
          }
      
          gpio_init_callback(&button_cb, button_pressed, BIT(button.pin));
          ret = gpio_add_callback(button.port, &button_cb);
          if (ret < 0) {
              return ret;
          }
      
          return gpio_pin_interrupt_configure_dt(&button, GPIO_INT_EDGE_TO_ACTIVE);
      }
    ''',
    'src/button.h': '''
      /*
       * Zephyr tactile button driver — public API.
       * Generated by demol — GPIO input with interrupt.
       */
      #ifndef DEMOL_BUTTON_H_
      #define DEMOL_BUTTON_H_
      
      #include <stdint.h>
      
      int button_init(void (*callback)(void));
      
      #endif /* DEMOL_BUTTON_H_ */
    ''',
    'src/main.c': '''
      /*
       * Zephyr application entry point.
       * Generated by demol -- driver logic is added in a later task.
       */
      
      #include <zephyr/kernel.h>
      #include <zephyr/net/mqtt.h>
      #include <zephyr/net/socket.h>
      
      static struct mqtt_client client;
      
      static void mqtt_init(void)
      {
              /* T16 skeleton: broker.connect, client.init.
               * Full publish loop is implemented in a later task.
               */
      }
      
      int main(void)
      {
              mqtt_init();
              return 0;
      }
  
    ''',
  })
