# name: test_device_repl_golden[esp_bme680.dev]
  '''
  using sysbus
  
  mach create "esp32"
  machine LoadPlatformDescription @platforms/boards/esp32_devkitc.repl
  
  sysbus Tag <0x40013000 0x40014000> "I2C0" 0x40013000 size 0x1000
  sysbus LoadELF @/tmp/firmware.elf
  
  '''
