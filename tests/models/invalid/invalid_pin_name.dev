// Invalid test model: Invalid pin name
// This model should FAIL validation with pin not found error

DEVICE InvalidPin WITH description="Invalid pin test", author="test", os=raspbian;

USE RaspberryPi_5_8GB;
USE LedGeneric[StatusLED];

NETWORK[WiFi] WITH ssid="test", password="test123";

BROKER[MQTT] TestBroker WITH host="localhost", port=1883, auth.username="test", auth.password="test", ssl=False;

CONNECT StatusLED WITH
    POWER
        gnd -- GND_1,
        vcc -- power_3v3_a
    DATA
        gpio[mode="output"] vin -- GPIO999
;
