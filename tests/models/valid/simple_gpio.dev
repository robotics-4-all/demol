// Valid test model: Simple GPIO peripheral connection
// This model should pass all validation checks

DEVICE SimpleGPIO WITH description="Simple GPIO test", author="test", os=raspbian;

USE RaspberryPi_5_8GB;
USE LedGeneric[StatusLED];

NETWORK[WiFi] WITH ssid="test", password="test123";

BROKER[MQTT] TestBroker WITH host="localhost", port=1883, auth.username="test", auth.password="test", ssl=False;

CONNECT StatusLED WITH
    POWER
        gnd -- GND_1,
        vcc -- power_3v3_a
    DATA
        gpio[mode="output"] vin -- GPIO17
;
