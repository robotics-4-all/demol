// Valid test model: I2C peripheral connection
// This model should pass all validation checks

DEVICE I2CTest WITH description="I2C test", author="test", os=raspbian;

USE RaspberryPi_5_8GB;
USE BME680[TempSensor];

NETWORK[WiFi] WITH ssid="test", password="test123";

BROKER[MQTT] TestBroker WITH host="localhost", port=1883, auth.username="test", auth.password="test", ssl=False;

CONNECT TempSensor WITH
    POWER
        GND_1 -- gnd,
        power_5v_a -- vcc
    DATA
        i2c[slave_address=0x76] sda GPIO2 -- sda, scl GPIO3 -- scl
;
