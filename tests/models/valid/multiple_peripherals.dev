DEVICE MultiPeripheral WITH description="Multiple peripherals test", author="test", os=raspbian;

USE RaspberryPi_5_8GB;
USE LedGeneric[LED1], LedGeneric[LED2], BME680[Sensor1];

NETWORK[WiFi] WITH ssid="test", password="test123";

BROKER[MQTT] TestBroker WITH host="localhost", port=1883, auth.username="test", auth.password="test", ssl=False;

CONNECT LED1 WITH
    POWER
        GND_1 -- gnd,
        power_3v3_a -- vcc
    DATA
        gpio[mode="output"] GPIO17 -- vin
;

CONNECT LED2 WITH
    POWER
        GND_2 -- gnd,
        power_3v3_b -- vcc
    DATA
        gpio[mode="output"] GPIO18 -- vin
;

CONNECT Sensor1 WITH
    POWER
        GND_3 -- gnd,
        power_5v_a -- vcc
    DATA
        i2c[slave_address=0x76] sda GPIO2 -- sda, scl GPIO3 -- scl
;
